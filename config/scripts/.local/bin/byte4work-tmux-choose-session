#!/usr/bin/env bash

session_list=$(tmux list-sessions -F "#{session_name}" 2>/dev/null)

if [[ -z "$session_list" ]]; then
    echo "No existing tmux sessions found. Exiting."
    exit 0
fi

selected=$(echo "$session_list" | fzf)

if [[ -z $selected ]]; then
    exit 0
fi

# echo "Attaching to session: $selected"

tmux attach-session -t "$selected"
