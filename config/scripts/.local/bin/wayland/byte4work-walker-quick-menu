#!/bin/bash

set -e

SCRIPTS_DIR="$HOME/.local/bin/wayland"
LOG_PATH="$SCRIPTS_DIR/logs/walker_quick_memu.log"

MON_NAME="HDMI-A-1"
MON_CFG="1920x1200@60,-1200x0,1,transform,1"

OPTIONS=(
    "Audio Output"
    "Audio Input"
    "Power Profile"
    "Toggle Sleep"
    "Toggle VPN"
    "Toggle Vertical Monitor"
    "Restart PipeWire"
    "Restart NetworkManager"
    "Restart Wifi wlan0"
)

logger() {
    mkdir -p "$(dirname "$LOG_PATH")"
    echo "$(date): $*" >>"$LOG_PATH"
}

for cmd in wpctl walker; do
    command -v $cmd >/dev/null 2>&1 || {
        echo "Missing $cmd"
        logger "Missing dependency: $cmd"
        notify-send "Missing dependency: $cmd"
        exit 1
    }
done

format_power_options() {
    local current=$(powerprofilesctl get)
    local output=""

    local modes=(
        "⚡️|performance"
        "⚖️|balanced"
        "🐢|power-saver"
    )

    for item in "${modes[@]}"; do
        local icon="${item%|*}"
        local m="${item#*|}"

        # 使用標準空格，確保 Walker 渲染一致
        local prefix="  "
        [[ "$m" == "$current" ]] && prefix="* "

        output+="$prefix $icon $m\n"
    done
    echo -ne "$output"
}

# 執行切換 (需在 sudoers 設定 NOPASSWD: /usr/bin/powerprofilesctl)
set_power_mode() {
    local target=$1
    local icon urgency msg

    logger "Setting power profile to: $target"

    # --- 根據模式設定視覺效果 ---
    case "$target" in
    "performance")
        icon="🚀"
        urgency="critical"
        msg="Maximum performance enabled. Fans may spin up."
        ;;
    "balanced")
        icon="⚖️"
        urgency="normal"
        msg="Dynamic balance between power and acoustics."
        ;;
    "power-saver")
        icon="🐢"
        urgency="low"
        msg="System throttled for silence and cool operation."
        ;;
    esac

    if err_msg=$(sudo powerprofilesctl set "$target" 2>&1); then
        notify-send -a "Power Manager" \
            -u "$urgency" \
            "$icon  Power Mode: ${target^^}" \
            "$msg"
    else
        logger "Power Mode Error: $err_msg"
        notify-send -a "Power Manager" -u critical "❌ Switch Failed" "$err_msg"
    fi
}

# Monitor Toggle Logic
toggle_monitor() {
    if hyprctl monitors | grep -q "$MON_NAME"; then
        logger "Disabling $MON_NAME"
        hyprctl keyword monitor "$MON_NAME,disable"
        notify-send "Monitor Manager" "🖥️ $MON_NAME Disabled"
    else
        logger "Enabling $MON_NAME with config: $MON_CFG"
        hyprctl keyword monitor "$MON_NAME,$MON_CFG"
        notify-send "Monitor Manager" "🖥️ $MON_NAME Enabled"
    fi
}

# --- 函數一：自動獲取所有 VPN 連線名稱 ---
get_vpn_connections() {
    # 獲取所有已配置的 VPN 名稱
    nmcli -t -f NAME,TYPE con show 2>/dev/null |
        grep -E ':(vpn|openvpn|wireguard|pptp|l2tp|vpnc|fortisslvpn|ipsec)$' |
        cut -d: -f1
}

# --- 函數二 (新增)：格式化 VPN 選項並加入狀態標記 ---
format_vpn_options() {
    # 獲取所有活躍的連線名稱，方便後續檢查
    local active_connections=$(nmcli -t -f NAME con show --active 2>/dev/null)

    # 獲取所有 VPN 連線名稱
    mapfile -t vpn_list < <(get_vpn_connections)

    local output=""
    local status_icon=""

    for vpn_name in "${vpn_list[@]}"; do
        # 檢查當前 VPN 名稱是否在活躍連線列表中
        if echo "$active_connections" | grep -q "^$vpn_name$"; then
            # 活躍，使用綠色圓點
            status_icon="🟢"
        else
            # 非活躍，使用紅色圓點
            status_icon="🔴"
        fi

        # 建立格式化的字串，中間使用 Tab 讓狀態和名稱對齊
        output+="$status_icon\t$vpn_name\n"
    done

    # 輸出所有格式化後的選項
    echo -e "$output"
}

# --- 通用 VPN 切換函數 ---
toggle_vpn() {
    local vpn_name="$1"
    logger "Toggling VPN: $vpn_name"

    # 檢查 VPN 連線是否處於活躍狀態 (Active)
    if nmcli con show --active | grep -q "^$vpn_name[[:space:]]"; then
        # 狀態為活躍 (Active)，執行斷開連線
        logger "VPN $vpn_name is active. Deactivating..."
        notify-send "VPN: Disconnecting" "Deactivating $vpn_name..."
        if nmcli con down "$vpn_name"; then
            notify-send "VPN: Disconnected 📴" "$vpn_name is now disconnected."
        else
            notify-send "VPN Error" "Failed to disconnect $vpn_name."
        fi
    else
        # 狀態為非活躍 (Inactive)，執行連接
        logger "VPN $vpn_name is inactive. Activating..."
        notify-send "VPN: Connecting..." "Activating $vpn_name..."
        if nmcli con up "$vpn_name" | grep -q "successfully activated"; then
            notify-send "VPN: Connected 🔒" "$vpn_name successfully connected."
        else
            notify-send "VPN Error ❌" "Failed to connect to $vpn_name. Check configuration/logs."
        fi
    fi
}
# --------------------

select_audio_device() {
    # ... (此函數內容保持不變，略過以簡化呈現)
    logger "Selected mode: $1"
    local section prompt devices selected_line selected
    if [[ "$1" == "Audio Output" ]]; then
        logger "Setting section to Sinks"
        section="Sinks"
        prompt="Select Audio Output Device"
    elif [[ "$1" == "Audio Input" ]]; then
        logger "Setting section to Sources"
        section="Sources"
        prompt="Select Audio Input Device"
    else
        notify-send "Unknown audio type: $1"
        exit 1
    fi

    # Parsing logic matches your actual format!
    devices=$(awk -v section="$section" '
        $0 ~ "^[[:space:]]*├─ "section":" { in_section=1; next }
        in_section && $0 ~ "^[[:space:]]*│" && $0 ~ /\[vol:/ {
            line=$0; sub(/^[ \t]*│[ \t]*/,"",line)
            is_default = match(line, /^\* +([0-9]+)\.\s+(.+)$/, parts)
            if (is_default) {
                id = parts[1]
                name = parts[2]
                printf "★ %s | %s\n", id, name
            } else if (match(line, /^([0-9]+)\.\s+(.+)$/, parts)) {
                id = parts[1]
                name = parts[2]
                printf "  %s | %s\n", id, name
            }
            next
        }
        in_section && $0 !~ "^[[:space:]]*│" { in_section=0 }
    ' < <(wpctl status))

    [ -z "$devices" ] && {
        notify-send "No devices found!"
        exit 1
    }

    selected_line=$(printf "%s\n" "$devices" | walker --dmenu --width 644 --minheight 1 --maxheight 300 -p "Select item…")

    [ -z "$selected_line" ] && exit 0

    selected=$(echo "$selected_line" | sed 's/^[★ ]*//' | cut -d'|' -f1 | awk '{print $1}')

    logger "User selected device ID: $selected"

    local assets="$HOME/.local/share/byte4work/assets/"
    local icon
    local mic="$assets/mic.png"
    local speaker="$assets/speaker.png"
    local headsets="$assets/headsets.png"

    if [[ "$section" == "Sinks" ]]; then
        icon="$speaker"
    else
        icon="$mic"
    fi

    if [[ "$section" == "Sinks" ]] && ([[ "$selected_line" == *"headset"* ]] || [[ "$selected_line" == *"Headset"* ]]); then
        icon="$headsets"
    fi

    wpctl set-default "$selected"
    notify-send -i "$icon" "Audio device switched" "$1 set to: $(echo "$selected_line" | cut -d'|' -f2- | xargs)"
}

main() {
    logger "Script started"

    selection=$(printf "%s\n" "${OPTIONS[@]}" | walker --dmenu --width 644 --minheight 1 --maxheight 300 -p "Select item…")
    [ -z "$selection" ] && exit 0

    logger "User selected: $selection"

    case "$selection" in
    "Audio Output" | "Audio Input")
        logger "Proceeding to select $selection device"
        select_audio_device "$selection"
        exit 0
        ;;

    "Power Profile")
        logger "Opening Power Profile submenu"
        local p_options=$(format_power_options)
        local selected_line=$(echo -e "$p_options" | walker --dmenu --width 644 --minheight 1 --maxheight 300 -p "Select Profile…")

        [ -z "$selected_line" ] && exit 0

        local selected_mode=$(echo "$selected_line" | awk '{print $NF}')

        if [ -n "$selected_mode" ]; then
            set_power_mode "$selected_mode"
        else
            logger "Error: Could not parse mode from $selected_line"
            notify-send -u critical "Parse Error" "Selected: $selected_line"
        fi
        exit 0
        ;;
    "Toggle Vertical Monitor")
        toggle_monitor
        exit 0
        ;;
    "Restart PipeWire")
        logger "Restarting PipeWire"
        "$SCRIPTS_DIR/byte4work-restart-pipewire"
        notify-send "PipeWire Restarted"
        exit 0
        ;;
    "Restart NetworkManager")
        logger "Restarting NetworkManager"
        notify-send "Restarting NetworkManager"
        "$SCRIPTS_DIR/byte4work-restart-network-manager"
        notify-send "NetworkManager Restarted"
        exit 0
        ;;
    "Restart Wifi wlan0")
        logger "Restarting Wifi wlan0"
        "$SCRIPTS_DIR/byte4work-restart-wifi-wlan0"
        notify-send "Wifi wlan0 Restarted"
        exit 0
        ;;

    "Toggle Sleep")
        logger "Toggle Sleep"
        "$SCRIPTS_DIR/byte4work-hypridle-toggle"
        exit 0
        ;;

    # --- 處理 VPN 子選單 (自動獲取選項並帶有狀態) ---
    "Toggle VPN")
        logger "User chose Toggle VPN. Getting list of VPN connections with status."

        # 呼叫新的格式化函數來獲取帶有狀態標記的選項
        local vpn_options_formatted=$(format_vpn_options)

        if [ -z "$vpn_options_formatted" ]; then
            logger "No VPN connections found."
            notify-send "VPN Error" "No configured VPN connections found."
            exit 0
        fi

        # 顯示子選單並獲取選定的 **完整行**
        local selected_line=$(echo -e "$vpn_options_formatted" | walker --dmenu --width 644 --minheight 1 --maxheight 300 -p "Select VPN to toggle…")

        [ -z "$selected_line" ] && {
            logger "VPN submenu cancelled."
            exit 0
        }

        # 從選定的行中，移除開頭的圓點和 Tab，只提取 VPN 名稱
        local selected_vpn=$(echo "$selected_line" | awk -F'\t' '{print $2}')

        # 呼叫通用的切換函數
        toggle_vpn "$selected_vpn"
        exit 0
        ;;
    # ----------------------------------------
    *)
        logger "Unknown option selected: $selection"
        notify-send "Unknown Selection" "The selected option '$selection' is not yet implemented."
        exit 0
        ;;
    esac
}

main
