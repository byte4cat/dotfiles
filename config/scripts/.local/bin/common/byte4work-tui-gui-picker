#!/bin/bash

# Ensure essential directories are in the PATH
PATH=/usr/bin:/usr/local/bin:$HOME/.local/bin

# Capture input from stdin
INPUT=$(cat)

if [ -z "$INPUT" ]; then
	exit 1
fi

# Get the process tree of the current script instance to determine the caller
# pstree -s $$ shows the process chain leading up to the current process
PARENT_TREE=$(pstree -s $$)

# List of known terminal emulators and shells
TERMINALS="bash|zsh|fish|sh|foot|kitty|alacritty|wezterm|gnome-terminal"

# Logic: If any terminal or shell emulator is found in the parent process tree,
# it indicates the script was triggered from an interactive terminal session.
if [[ "$PARENT_TREE" =~ ($TERMINALS) ]]; then
	# Use fzf for TUI selection.
	echo "$INPUT" | fzf --height=40% --reverse --prompt="Select: "
else
	# Default to GUI mode using wofi for Hyprland/Wayland environments.
	echo "$INPUT" | wofi --dmenu --allow-markup --width=400 --lines=10
fi
