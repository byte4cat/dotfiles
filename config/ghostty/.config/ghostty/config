# Ghostty Config

theme = "Catppuccin Mocha"
background = 000000
background-opacity = 1

font-family = "Comic Code"
font-family = "Jetbrains Mono Nerd Font"
font-family = "LXGWWenKai Mono" # 霞鶩文楷 -> 中文測試

font-feature = "calt"
font-feature = "liga"

font-size = 14

adjust-cell-height = 15%

shell-integration-features = no-cursor,no-sudo,no-title

gtk-titlebar = false

confirm-close-surface = false

clipboard-read = allow
clipboard-write = allow


# ctrl a is a command prefix
keybind = "ctrl+a>ctrl+shift+s=text:ts\x0d"
keybind = "ctrl+a>ctrl+s=text:ts\x1d"
keybind = "ctrl+a>ctrl+f=text:tc\x0d"


keybind = "ctrl+shift+f=scroll_page_fractional:0.5"
keybind = "ctrl+shift+b=scroll_page_fractional:-0.5"


# remove toggle fullscreen
keybind = "ctrl+enter=unbind"
keybind = "shift+enter=unbind"
