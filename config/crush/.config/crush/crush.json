          "can_reason": false,
          "supports_attachments": true
        },
        {
          "name": "Qwen 2.5 Coder 32B",
          "id": "qwen2.5-coder:32b",
          "context_window": 32768,
          "default_max_tokens": 8192,
          "can_reason": false,
          "supports_attachments": true
        },
        {
