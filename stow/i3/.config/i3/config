# i3 Configuration File based on Hyprland settings

####################
### 1. 變數設定 ###
####################
font pango:monospace 8

# 設置 Mod 鍵為 Super (Windows 鍵)
set $mod Mod4
set $altMod Mod1

# 設置你的程式
set $terminal ghostty
set $fileManager nautilus
# i3 通常使用 dmenu 或 rofi。wofi 是 Wayland 原生。
set $menu rofi -show drun
set $browser chromium --enable-features=Vulkan --enable-webgl --ignore-gpu-blacklist
set $workmsg flatpak run dev.vencord.Vesktop

#######################
### 2. 環境變數/佈景主題 ###
#######################

# 設定 GTK/Qt 主題
exec --no-startup-id gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"
exec --no-startup-id gsettings set org.gnome.desktop.interface gtk-theme "adw-gtk3"
# i3/X11 的環境變數設定
exec --no-startup-id xrandr --output DisplayPort-1 --mode 1920x1200 --pos 0x0 --rotate left --output HDMI-A-1 --mode 3840x2160 --pos 1200x0 --primary

# 開機啟動
# set $ws1 "1:Term"
# set $ws2 "2:Web"
#
# assign [class="Ghostty"] $ws1
# assign [class="Chromium"] $ws2
#
exec --no-startup-id dunst
# exec --no-startup-id $browser

exec --no-startup-id xsetroot -cursor_name left_ptr
set $gaps_in 5
set $gaps_out 10

###################
### 3. AUTOSTART ###
###################

# i3 使用 exec --no-startup-id 確保程式背景運行
# 替換 hyprpaper
exec_always --no-startup-id feh --bg-fill ~/.config/wallpapers/Anime/168847-man_de_nu_hai-ka_tong-ren_men_zai_zi_ran_jie-kuai_le_de-yang_guang-3840x2160.jpg
# 替換 waybar，你需要安裝和設定 polybar
exec --no-startup-id polybar
# exec --no-startup-id i3bar # 如果你使用內建的 i3status
exec --no-startup-id fcitx5
# X11 上的剪貼簿歷史管理，需要安裝 clipmenud
exec --no-startup-id clipmenud &
# 啟用 Polkit
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
# xhost +SI:localuser:root (在 X11 上保留此項以防萬一，但通常不必要)
# exec --no-startup-id xhost +SI:localuser:root
# --- 新增 Picom 啟動 ---
exec --no-startup-id picom --config ~/.config/picom/picom.conf

#########################
### 4. 視窗外觀與規則 ###
#########################

# 視窗邊框設定 (模擬你的 Hyprland 設定)
gaps inner $gaps_in
gaps outer $gaps_out

# 視窗邊框設定 (模擬你的 Hyprland 設定)
# 預設邊框為 1 像素 (i3 的 'pixel' 邊框類型)
default_border pixel 1

# i3 的 fullscreen 模式通常會自動隱藏邊框，但若沒有，
# 則確保所有視窗的預設 border style 適用 1 像素。
for_window [class="^.*"] border pixel 1

# 視窗圓角 (i3 不原生支援，但某些 Compositor 如 picom 可以實現)
exec --no-startup-id picom -b # 啟用 picom 模擬模糊和陰影

# 模擬浮動視窗規則 (i3 的 float rule)
# 浮動應用程式 (例如你的 wofi/rofi, Nautilus/Nemo, Wlogout)
for_window [class="Rofi|Wofi"] floating enable
for_window [class="Rofi|Wofi"] focus_on_window activation
for_window [class="Rofi|Wofi"] move position center

# 模擬 Hyprland 的全螢幕閒置抑制 (需要 xautolock/i3lock)
# exec --no-startup-id xautolock -time 10 -locker 'i3lock -i /path/to/lock.png' # 閒置鎖定範例

###################
### 5. 按鍵綁定 ###
###################

# i3 使用 bindsym 語法

# 基礎操作
bindsym $mod+Return exec $terminal
bindsym $mod+q kill
bindsym $mod+e exec $fileManager
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+f floating toggle
bindsym $mod+c exec $browser
bindsym $altMod+space exec $menu

bindsym $mod+v exec ~/.local/bin/x11/rofi_quick_memu
bindsym $mod+Shift+e exec ~/.local/bin/x11/rofi-emoji

# 浮動視窗
# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod
# move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.
tiling_drag modifier titlebar

# 專注移動 (與 Hyprland 相同)
bindsym $mod+h focus left
bindsym $mod+l focus right
bindsym $mod+k focus up
bindsym $mod+j focus down

# 視窗移動 (與 Hyprland 相同)
bindsym $mod+Shift+h move left
bindsym $mod+Shift+l move right
bindsym $mod+Shift+k move up
bindsym $mod+Shift+j move down

# 工作區切換 (與 Hyprland 相同)
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# 移動視窗到工作區 (與 Hyprland 相同)
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# 佈局切換 (i3 內建)
# 替換 Hyprland 的 'dwindle' 概念
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+t layout toggle split

# Workspace
workspace 1 output HDMI-A-1
workspace 2 output HDMI-A-1
workspace 3 output HDMI-A-1
workspace 4 output HDMI-A-1
workspace 5 output HDMI-A-1
workspace 6 output DisplayPort-1
workspace 7 output DisplayPort-1
workspace 8 output DisplayPort-1
workspace 9 output DisplayPort-1
workspace 10 output DisplayPort-1

# 截圖 (替換 hyprshot，使用 X11 截圖工具 scrot)
# scrot -s 選擇區域, -u 選擇視窗, -d 1 延遲 1 秒, -c 複製到剪貼簿 (需要 xclip)
# Region screenshot
bindsym $mod+Control+3 exec ~/.local/bin/x11/screenshot region

# Window screenshot
bindsym $mod+Control+2 exec ~/.local/bin/x11/screenshot window

# Fullscreen screenshot
bindsym $mod+Control+1 exec ~/.local/bin/x11/screenshot window

# Selection + Save
bindsym $mod+Control+Shift+3 exec ~/.local/bin/x11/screenshot save-region

# Window + Save
bindsym $mod+Control+Shift+2 exec ~/.local/bin/x11/screenshot save-window

# Fullscreen + Save
bindsym $mod+Control+Shift+1 exec ~/.local/bin/x11/screenshot save-full

# 剪貼簿歷史 (替換 wl-copy/cliphist，使用 X11 剪貼簿工具)
# 需要安裝 clipmenu
bindsym $mod+$altMod+c exec sh -c 'clipmenu'

# 媒體鍵 (保持 wpctl 和 brightnessctl)
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl -e4 -n2 set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl -e4 -n2 set 5%-
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPrev exec playerctl previous

# 退出 i3
bindsym $mod+Shift+m exec i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'

