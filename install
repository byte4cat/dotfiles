#!/bin/bash
# ==============================================================================
# Dotfiles Installation and Setup Script (Stow Version)
#
# Author: byte4cat
# Date: 2025-07-13 15:58:48 UTC
#
# Description:
#   This script bootstraps and installs dotfiles for Linux systems.
#   It performs:
#     1. Git clone (if needed)
#     2. Dependency check (git, stow)
#     3. Stow-based symlink creation
#     4. Package installation (Arch Linux)
#
# Usage:
#   Run ./install.sh from the dotfiles root directory.
# ==============================================================================

set -euo pipefail

# --- Color Definitions ---
Green='\033[0;32m'
Red='\033[0;31m'
Blue='\033[1;34m'
Yellow='\033[0;33m'
Reset='\033[0m'

# --- Helper Functions ---
info() { echo -e "${Blue}[INFO] ${1}${Reset}"; }
success() { echo -e "${Green}${1}${Reset}"; }
warn() { echo -e "${Yellow}[WARN] ${1}${Reset}"; }
error() {
    echo -e "${Red}[ERROR] ${1}${Reset}" >&2
    exit 1
}

# --- Global Variable ---
export DOTFILES_DIR="$HOME/dotfiles"

# --- 1. Bootstrap: Clone Repository ---
bootstrap() {
    info "Starting bootstrap process..."
    info "Dotfiles will be cloned to: ${DOTFILES_DIR}"

    if ! command -v git &>/dev/null; then
        error "'git' is required for bootstrapping. Please install it first."
    fi

    if [ -d "$DOTFILES_DIR" ]; then
        success "Dotfiles directory already exists at $DOTFILES_DIR."
    else
        info "Cloning dotfiles repository..."
        git clone -q --depth=1 "https://github.com/byte4cat/dotfiles.git" "$DOTFILES_DIR"
        success "Repository cloned successfully."
    fi

    cd "$DOTFILES_DIR"
}

# --- 2. Check Dependencies ---
check_dependencies() {
    info "Checking for core dependencies..."
    local missing_deps=0
    for cmd in git stow; do
        if ! command -v "$cmd" &>/dev/null; then
            warn "$cmd is not installed."
            missing_deps=1
        fi
    done

    if [ $missing_deps -ne 0 ]; then
        error "Please install the missing dependencies and run the script again."
    fi
    success "All core dependencies are installed."
}

# --- 3. Stow dotfiles ---
stow_dotfiles() {
    info "Stowing all dotfiles packages..."
    if [ ! -d "stow" ]; then
        error "'stow' directory not found. Make sure you are in the dotfiles root."
    fi

    local linux_only=(fcitx5 waybar wofi hyprland tofi dunst)

    local os="$(uname)"
    for pkg in stow/*; do
        [ -d "$pkg" ] || continue
        pkg_name=$(basename "$pkg")

        if [[ "$os" != "Linux" ]] && [[ " ${linux_only[*]} " == *" $pkg_name "* ]]; then
            warn "Skipping $pkg_name (Linux only)"
            continue
        fi

        info "Stowing package: $pkg_name"
        stow -d stow -t "$HOME" --restow "$pkg_name"
    done

    if [ -d "private" ]; then
        mkdir -p "$HOME/.local/private"
        info "Stowing private..."
        stow -v -d . -t "$HOME/.local/private" --restow private
    fi

    success "Symbolic links created successfully."
}

# --- 4. Install Tmux Plugin Manager ---
install_tmux_plugins() {
    info "Checking and installing Tmux Plugin Manager (TPM)..."
    local tpm_dir="$HOME/.tmux_plugins/tpm"

    if [ ! -d "$tpm_dir" ]; then
        info "TPM not found. Cloning..."
        git clone -q --depth=1 https://github.com/tmux-plugins/tpm "$tpm_dir"
        success "TPM installed successfully."
    else
        warn "TPM already installed, skipping."
    fi
}

# --- 5. Arch Linux Installation Flow ---
install_linux_arch() {
    info "Starting Arch Linux installation process..."

    read -rp "Proceed with Arch Linux package installation? (y/n): " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        warn "Installation aborted by user."
        exit 0
    fi

    local pacman_packages=(
        "zsh" "tmux" "neovim" "git" "wget" "docker"
        "fcitx5-im" "fcitx5-chewing"
        "bat" "ripgrep" "fd" "fzf" "jq" "htop" "btop" "tree" "nmap"
        "go" "unzip" "ffmpeg"
    )

    local aur_packages=(
        "fastfetch" "yazi" "hyprshot"
    )

    # --- Ensure yay exists ---
    if ! command -v yay &>/dev/null; then
        warn "AUR helper 'yay' not found. Installing..."
        sudo pacman -S --noconfirm --needed base-devel git
        local yay_dir="/tmp/yay-install"
        git clone https://aur.archlinux.org/yay.git "$yay_dir"
        (cd "$yay_dir" && makepkg -si --noconfirm)
        rm -rf "$yay_dir"
        success "'yay' installed successfully."
    fi

    # --- Pacman Packages ---
    info "Installing pacman packages..."
    sudo pacman -Syu --noconfirm
    for package in "${pacman_packages[@]}"; do
        if ! pacman -Q "$package" &>/dev/null; then
            info "Installing: $package"
            sudo pacman -S --noconfirm --needed "$package"
        else
            warn "$package already installed, skipping."
        fi
    done

    # --- AUR Packages ---
    info "Installing AUR packages..."
    for package in "${aur_packages[@]}"; do
        if ! yay -Q "$package" &>/dev/null; then
            info "Installing (AUR): $package"
            yay -S --noconfirm --needed "$package"
        else
            warn "(AUR) $package already installed, skipping."
        fi
    done

    # --- Post-installation ---
    mkdir -p "$HOME/Screenshots"
    success "Created ~/Screenshots directory."

    sudo systemctl enable --now docker.service
    sudo usermod -aG docker "$USER"
    warn "Re-login required for Docker group permissions."

    sudo gtk-update-icon-cache /usr/share/icons/hicolor
    warn "Restart Fcitx5 to apply input method changes."

    success "Arch Linux installation process completed!"
}

# --- Main Entry Point ---
main() {
    bootstrap
    check_dependencies
    stow_dotfiles

    if [[ "$(uname)" == "Linux" ]]; then
        if [[ -f /etc/arch-release ]] || grep -q "Arch Linux" /etc/os-release 2>/dev/null; then
            install_linux_arch
            install_tmux_plugins
        else
            warn "Unsupported Linux distribution. Manual installation required."
        fi
    else
        warn "Unsupported operating system: $(uname)"
    fi

    success "🎉 Dotfiles setup complete! 🎉"
    warn "Restart your terminal or run 'source ~/.zshrc' for changes to take effect."
}

main
