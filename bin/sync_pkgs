#!/bin/bash

# Exit immediately if a command exits with a non-zero status,
# treat unset variables as an error, and catch errors in pipelines.
set -euo pipefail

# Get the script's actual path using BASH_SOURCE
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REQUIREMENTS_DIR="$(dirname "$SCRIPT_DIR")/requirements"

# Ensure the requirements directory exists
mkdir -p "$REQUIREMENTS_DIR"

echo "Analyzing system packages..."

# Temporary files for fast set operations
TMP_EXPLICIT=$(mktemp)
TMP_REPOS=$(mktemp)

# Clean up temporary files on script exit
trap 'rm -f "$TMP_EXPLICIT" "$TMP_REPOS"' EXIT

# Get sorted list of all explicitly installed packages
yay -Qeq | sort >"$TMP_EXPLICIT"

# Dynamically get all unique package names available in active synced repositories
# (Automatically covers core, extra, multilib, and ALL CachyOS architecture repos)
pacman -Slq | sort -u >"$TMP_REPOS"

echo "Generating pacman_list.txt (Official/Synced Repos)..."
# comm -12 outputs lines common to both files (Intersection)
comm -12 "$TMP_EXPLICIT" "$TMP_REPOS" >"$REQUIREMENTS_DIR/pacman_list.txt"

echo "Generating aur_list.txt (AUR/Foreign)..."
# Filter out *-debug packages right from the start
yay -Qmq | grep -v '\-debug$' | sort >"$REQUIREMENTS_DIR/aur_list.txt"

echo "----------------------------------------"
echo "Update complete!"
echo "- Official Repos: $REQUIREMENTS_DIR/pacman_list.txt"
echo "- AUR Packages:   $REQUIREMENTS_DIR/aur_list.txt"
echo "Please review the generated files and manually remove any unwanted packages."
