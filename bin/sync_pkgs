#!/bin/bash

# use BASH_SOURCE to get the script actual path
# SCRIPT_DIR will be: ~/dotfiles/bin
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ~/dotfiles/requirements
REQUIREMENTS_DIR="$(dirname "$SCRIPT_DIR")/requirements"

echo "Generating pacman_list.txt..."

# Exports all explicitly installed packages (not dependencies) using pacman -Qe.
# Excludes common base system packages (adjust this exclusion list as needed).
pacman -Qeq | grep -v 'archlinux-keyring\|base\|bash\|btrfs-progs\|coreutils\|device-mapper\|diffutils\|e2fsprogs\|file\|filesystem\|findutils\|gawk\|gcc-libs\|glibc\|grep\|gzip\|iproute2\|iputils\|less\|libcap\|logrotate\|lvm2\|man-db\|man-pages\|mdadm\|nano\|netctl\|pacman\|pacman-mirrorlist\|pciutils\|procps-ng\|psmisc\|sed\|shadow\|systemd\|systemd-sysv\|tar\|texinfo\|util-linux\|vi\|which' | sort >"$REQUIREMENTS_DIR/pacman_list.txt"

echo "pacman_list.txt updated."

echo "Generating aur_list.txt..."

# Exports all packages installed from the AUR.
yay -Qmq >"$REQUIREMENTS_DIR/aur_list.txt"

echo "aur_list.txt updated."

echo "Please review the generated files and manually remove any unwanted packages."
