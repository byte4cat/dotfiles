#!/bin/bash

# Get the script's actual directory
# SCRIPT_DIR will be: ~/dotfiles/bin
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Set the requirements directory path (one level up from bin)
REQUIREMENTS_DIR="$(dirname "$SCRIPT_DIR")/requirements"

# Ensure the requirements directory exists
mkdir -p "$REQUIREMENTS_DIR"

echo "Step 1: Exporting official packages (pacman_list.txt)..."
# -Qentq: Query, Explicitly installed, Native (official repos), Unrequired (not deps), Quiet (name only)
pacman -Qentq | sort >"$REQUIREMENTS_DIR/pacman_list.txt"

echo "Step 2: Exporting AUR packages (aur_list.txt)..."
# -Qmq: Query, Foreign (AUR/manual), Quiet (name only)
# This works even if yay is broken.
pacman -Qmq | sort >"$REQUIREMENTS_DIR/aur_list.txt"

echo "--------------------------------------------------"
echo "Package sync completed successfully!"
echo "Official packages found: $(wc -l <"$REQUIREMENTS_DIR/pacman_list.txt")"
echo "AUR packages found:      $(wc -l <"$REQUIREMENTS_DIR/aur_list.txt")"
echo "Location: $REQUIREMENTS_DIR"
echo "Ensure this directory is included in your rsync backup."
echo "--------------------------------------------------"
