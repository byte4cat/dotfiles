#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REQUIREMENTS_DIR="$(dirname "$SCRIPT_DIR")/requirements"

mkdir -p "$REQUIREMENTS_DIR"

echo "Analyzing system packages..."

# 1. 取得所有明確安裝（Explicitly installed）的包
# -Qeq 只列出明確安裝的非依賴包
# 這裡我們加上 grep -v 用來過濾掉你不想自動保存的開發調試包
yay -Qeq | grep -vE '\-(debug|git|svn|hg|bzr)$' | sort >/tmp/explicit_pkgs.txt

# 2. 取得官方倉庫中的所有包
pacman -Slq | sort -u >/tmp/repo_pkgs.txt

# 3. 生成官方包列表 (交集)
comm -12 /tmp/explicit_pkgs.txt /tmp/repo_pkgs.txt >"$REQUIREMENTS_DIR/pacman_list.txt"

# 4. 生成 AUR 包列表 (差異集)
# 使用 comm -23，從明確安裝列表中排除掉官方倉庫已有的包，剩下的就是 AUR/Foreign
comm -23 /tmp/explicit_pkgs.txt /tmp/repo_pkgs.txt | grep -vE '\-(debug|git|svn|hg|bzr)$' >"$REQUIREMENTS_DIR/aur_list.txt"

# 清理
rm /tmp/explicit_pkgs.txt /tmp/repo_pkgs.txt

echo "----------------------------------------"
echo "Success! Packages categorized:"
echo "- Official Repos: $(wc -l <"$REQUIREMENTS_DIR/pacman_list.txt") packages"
echo "- AUR Packages:   $(wc -l <"$REQUIREMENTS_DIR/aur_list.txt") packages"
