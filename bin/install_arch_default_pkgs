#!/usr/bin/env bash

# ==============================================================================
# Arch Linux System Core Component Installer
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="$(dirname "$SCRIPT_DIR")"
source "$DOTFILES_DIR/lib/common"

# System Upgrade & Base Layer
info "=== System Base & Build Layer ==="
if confirm "Would you like to perform a full system upgrade now?"; then
	sudo pacman -Syu --noconfirm
fi
sudo pacman -S --noconfirm --needed git base-devel ccache linux-headers p7zip unzip tar

# AUR Helper (yay)
if ! command -v yay &>/dev/null; then
	info "=== Installing yay ==="
	_tmp_dir=$(mktemp -d /tmp/yay-build-XXXXXX)
	cd_or_error "$_tmp_dir"
	git clone https://aur.archlinux.org/yay.git .
	makepkg -si --noconfirm
	cd - >/dev/null && rm -rf "$_tmp_dir"
else
	success "yay is already installed."
fi

# System Ecosystem, Audio, & Networking
info "=== System Ecosystem & Networking ==="
sudo pacman -S --noconfirm --needed \
	networkmanager network-manager-applet bluez bluez-utils \
	pipewire wireplumber pipewire-pulse pipewire-alsa \
	openssh curl jq ripgrep fd bat eza tree btop htop ncdu

sudo systemctl enable --now NetworkManager bluetooth
# Note: Pipewire is usually handled by user-space, no systemctl needed for session

# Desktop & Hyprland Infrastructure
info "=== Desktop & Hyprland Helpers ==="
sudo pacman -S --noconfirm --needed \
	adw-gtk-theme nwg-look dunst waybar yazi libnotify \
	xdg-desktop-portal-hyprland grim slurp satty wl-clipboard \
	brightnessctl playerctl \
	ttf-jetbrains-mono-nerd ttf-liberation noto-fonts-cjk noto-fonts-emoji noto-fonts-extra

# Developer Tooling (Rust / Node / C / Go)
info "=== Developer Tooling ==="
sudo pacman -S --noconfirm --needed zsh rustup tmux gdb lld vlc go starship
rustup default stable

# ZSH Shell setup
if [ "${SHELL:-}" != "/bin/zsh" ]; then
	chsh -s /bin/zsh
fi
sudo pacman -S --noconfirm --needed zsh-autosuggestions zsh-history-substring-search zsh-syntax-highlighting

# NVM Environment
export NVM_DIR="$HOME/.nvm"
if [ ! -d "$NVM_DIR" ]; then
	curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash
fi
[ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh" && nvm install --lts

# Multimedia & Input
info "=== Multimedia & Input ==="
sudo pacman -S --noconfirm --needed \
	vlc-plugin-ffmpeg vlc-plugin-live555 vlc-plugins-all vlc-plugins-extra libva-utils libvdpau \
	fcitx5-chewing fcitx5-chinese-addons fcitx5-configtool fcitx5-gtk rime-double-pinyin

# Applications
info "=== Applications ==="
sudo pacman -S --noconfirm --needed ghostty awww firefox

# Setup Tmux Plugin Manager
if [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
	git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
fi

# NOTE: Commented out due to recent AUR security alerts / supply chain risks
# info "=== AUR Custom Targets (yay) ==="
# yay -S --noconfirm --needed \
#      fcitx5-mcbopomofo-git \
#      swayosd-git \
#      librewolf-bin \
#	   fzf-tab \
#  	   hyprshade \
#  	   waypaper

success "========================================="
success "🎉 System deployment completed successfully!"
success "Please log out and log back in to finalize environment settings."
success "========================================="
