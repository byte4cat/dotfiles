#!/usr/bin/env bash

# ==============================================================================
# Arch Linux System Deployment Script
# ==============================================================================
set -euo pipefail

# Load environment and common library functions
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="$(dirname "$SCRIPT_DIR")"
source "$DOTFILES_DIR/lib/common"

# System Base & Build Layer
info "=== [1/7] System Base & Build Layer ==="
if confirm "Perform a full system upgrade?"; then
	sudo pacman -Syu --noconfirm
fi
sudo pacman -S --noconfirm --needed git git-lfs base-devel ccache linux-headers \
	unrar unzip tar 7zip stow git-delta

# AUR Helper (yay)
if ! command -v yay &>/dev/null; then
	info "Installing yay..."
	_tmp_dir=$(mktemp -d /tmp/yay-build-XXXXXX)
	git clone https://aur.archlinux.org/yay.git "$_tmp_dir"
	(cd "$_tmp_dir" && makepkg -si --noconfirm)
	rm -rf "$_tmp_dir"
fi

# Developer Tooling (Compilers & Core Dependencies)
info "=== [2/7] Developer Tooling ==="
sudo pacman -S --noconfirm --needed \
	cmake meson ninja gcc clang make pkg-config libxkbcommon \
	libinput libxcb xcb-util xcb-util-keysyms xcb-util-wm xcb-util-renderutil \
	zsh rustup tmux gdb lld vlc go starship fnm code neovim docker docker-compose docker-buildx \
	words gvim man-db man-pages

# for markdown and documents converts
sudo pacman -S --noconfirm --needed \
	typst python-markdown python-weasyprint python-pygments

# Setup Node.js via FNM
info "Setting up nodejs tool chain"
eval "$(fnm env --use-on-cd)"
fnm install --lts
# Setup Rust
info "Setting up rustup tool chain"
rustup default stable
# Setup docker
info "Setting up docker environment"
sudo systemctl enable --now docker
# Add user to docker group if not already present
if ! getent group docker | grep -q "\b$USER\b"; then
	sudo usermod -aG docker "$USER"
	success "Added $USER to docker group (requires re-login)."
fi

# System Ecosystem, Audio & Networking
info "=== [3/7] Ecosystem & Networking ==="
sudo pacman -S --noconfirm --needed \
	networkmanager network-manager-applet bluez bluez-utils fail2ban \
	pipewire wireplumber pipewire-pulse pipewire-alsa pipewire-jack gst-plugin-pipewire \
	openssh curl jq ripgrep fd fzf bat eza tree btop htop ncdu

sudo systemctl enable --now NetworkManager bluetooth fail2ban

# Desktop Environment (Hyprland Infrastructure)
info "=== [4/7] Desktop Environment ==="
sudo pacman -S --noconfirm --needed \
	fastfetch matugen rofi-wayland swaync thunar thunar-archive-plugin file-roller \
	qt5-wayland qt6-wayland polkit-kde-agent adw-gtk-theme nwg-look dunst waybar yazi libnotify \
	quickshell cliphist xdg-desktop-portal-hyprland grim slurp satty wl-clipboard \
	brightnessctl playerctl swayosd awww zoxide gnome-disk-utility zathura zathura-pdf-poppler \
	spotify-launcher

info "=== AUR Custom Targets (yay) ==="
yay -S --noconfirm --needed \
	librewolf-bin \
	fzf-tab \
	hyprshade \
	waypaper \
    elephant-bin \
    elephant-bluetooth-bin \
    elephant-calc-bin \
    elephant-clipboard-bin \
    elephant-desktopapplications-bin \
    elephant-files-bin \
    elephant-menus-bin \
    elephant-providerlist-bin \
    elephant-symbols-bin \
    elephant-todo-bin \
    elephant-unicode-bin \
    elephant-websearch-bin \
    walker-bin \
    fcitx5-mcbopomofo-git \
    mongodb-compass-bin \
	networkmanager-fortisslvpn \
	another-redis-desktop-manager-bin \
	bruno-bin \
	postman-bin \
	freelens-bin \
	localsend-bin
# wombat-bin # required webkit2gtk, outdated (project archive) since 2021.

# Waypaper default state file
# If this file doesn't exist, the hotkey script (Super+W) won't work.
WAYPAPER_DIR="$HOME/.local/state/waypaper"
WAYPAPER_STATE_FILE="$WAYPAPER_DIR/default.toml"
if [ ! -f "$WAYPAPER_STATE_FILE" ]; then
	mkdir -p "$WAYPAPER_DIR"
	touch "$WAYPAPER_STATE_FILE"
	echo "Created empty Waypaper default state file: $WAYPAPER_STATE_FILE"
fi

info "=== Installing Purchased Fonts ==="
# Define the source of your purchased fonts
PURCHASED_FONTS_DIR="$DOTFILES_DIR/private/fonts"

if [ -d "$PURCHASED_FONTS_DIR" ]; then
	# Create the user font directory
	mkdir -p "$HOME/.local/share/fonts"

	# Copy all font files (ttf, otf) to the local font folder
	cp "$PURCHASED_FONTS_DIR"/*.{ttf,otf} "$HOME/.local/share/fonts/" 2>/dev/null || true

	# Refresh the font cache so the system detects the new files
	fc-cache -fv
	success "Purchased fonts installed successfully."
else
	warn "Purchased fonts directory not found, skipping..."
fi

# Multimedia, Fonts & Input Methods
info "=== [5/7] Multimedia, Fonts & Input ==="
sudo pacman -S --noconfirm --needed \
	ffmpeg mpv vlc-plugin-ffmpeg vlc-plugin-live555 vlc-plugins-all vlc-plugins-extra libva-utils libvdpau \
	fcitx5-chinese-addons fcitx5-configtool fcitx5-gtk rime-double-pinyin \
	ttf-jetbrains-mono-nerd ttf-liberation noto-fonts-cjk noto-fonts-emoji noto-fonts-extra \
	ttf-font-awesome otf-font-awesome ttf-roboto adobe-source-sans-fonts

# Shell Configuration & Finalization
info "=== [6/7] Finalizing Environment ==="
# Set ZSH as default shell
[ "${SHELL:-}" != "/bin/zsh" ] && sudo chsh -s /bin/zsh "$USER" || true
sudo pacman -S --noconfirm --needed zsh-autosuggestions zsh-history-substring-search zsh-syntax-highlighting

# Setup Tmux Plugin Manager
[ ! -d "$HOME/.tmux/plugins/tpm" ] && git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"

if [ -f "$SCRIPT_DIR/sync_dotfiles" ]; then
	chmod +x "$SCRIPT_DIR/sync_dotfiles"
	rm -f "$HOME/.config/hypr/hyprland.lua"
	bash "$SCRIPT_DIR/sync_dotfiles"
else
	warn "Stow script not found, please run it manually."
fi

# check if dotfile sync, so that neovim setting is right there
# Neovim background install
info "Setting up neovim plugins and LSP servers"
export PATH="$HOME/.fnm:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"
mkdir -p "$HOME/.local/state"
nohup bash -c 'nvim --headless "+Lazy! sync" "+MasonUpdate" "+MasonInstallAll" +qa' >"$HOME/.local/state/nvim_install.log" 2>&1 &
success "Neovim installation started in the background. Check logs at ~/.local/state/nvim_install.log"

# Pull wallpapers
git lfs pull

# Generate matugen colors
DEFAULT_WALLPAPER="$HOME/dotfiles/modules/wallpapers/.local/share/wallpapers/wp12195667-arch-linux-4k-wallpapers.jpg"
if [ -f "$DEFAULT_WALLPAPER" ]; then
	matugen image "$DEFAULT_WALLPAPER" --quiet
	# Launch awww-daemon if it's not running
	pgrep -x awww-daemon >/dev/null || nohup awww-daemon >/dev/null 2>&1 &
	awww img "$DEFAULT_WALLPAPER"
else
	warn "Wallpaper not found at $DEFAULT_WALLPAPER, skipping matugen initialization."
fi

# Install main applications
sudo pacman -S --noconfirm --needed ghostty awww firefox

# Environment Health Check
info "=== [7/7] Environment Check ==="
for service in NetworkManager bluetooth fail2ban; do
	systemctl is-active --quiet "$service" && success "$service is running." || warn "$service is NOT running!"
done

success "========================================="
success "🎉 System deployment completed successfully!"
echo "Note: Neovim plugins are being installed in the background."
echo "You can monitor progress with: tail -f ~/.local/state/nvim_install.log"
success "Please log out and log back in to apply all changes."
success "========================================="
