#!/bin/bash

# ==============================================================================
# Stow Dotfiles Deployment Script
# ==============================================================================
set -euo pipefail

# use BASH_SOURCE to get the script actual path
# SCRIPT_DIR will be: ~/dotfiles/bin
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# root path (e.g., ~/dotfiles)
DOTFILES_DIR="$(dirname "$SCRIPT_DIR")"

source "$DOTFILES_DIR/lib/common"

cd_or_error "$DOTFILES_DIR"

prepare_host_files() {
	local current_host
	if command -v hostname >/dev/null 2>&1; then
		current_host=$(hostname)
	elif [ -f /etc/hostname ]; then
		current_host=$(cat /etc/hostname)
	else
		current_host=$(uname -n)
	fi

	# Fallback if still empty
	[ -z "$current_host" ] && current_host="unknown"

	local current_os
	current_os=$(uname -s)

	info "🏠 Detected system: Hostname=[$current_host], OS=[$current_os]"

	# Prompt user to verify the target hostname
	if ! confirm "Is this the correct hostname for deployment?"; then
		read -rp "Please enter the target hostname manually: " custom_host
		if [ -z "$custom_host" ]; then
			error "Hostname cannot be empty. Aborting deployment."
		fi
		current_host="$custom_host"
		info "🏠 Overriding target hostname to: $current_host"
	fi

	# ==========================================================================
	# Alternate File Priorities (Highest to Lowest)
	# ==========================================================================
	local priorities=(
		"hostname.${current_host}"
		"os.${current_os}"
		"default"
	)

	local search_dirs=(
		"$DOTFILES_DIR/modules"
		"$DOTFILES_DIR/private/modules"
	)

	local match_count=0

	for dir in "${search_dirs[@]}"; do
		[ -d "$dir" ] || continue

		# # Find all alternate files containing '##' and extract unique base file paths
		while IFS= read -r -d '' base_file; do
			local chosen_alt=""
			local base_name="$(basename "$base_file")"

			# Evaluate suffix rules in order of priority
			for suffix in "${priorities[@]}"; do
				if [ -f "${base_file}##${suffix}" ]; then
					chosen_alt="${base_file}##${suffix}"
					break # 找到最高優先權的檔案就立刻跳出迴圈！
				fi
			done

			# Process matched alternate file
			if [ -n "$chosen_alt" ]; then
				# Prevent structural conflict: Base file must not be tracked in Git
				if git ls-files --error-unmatch "$base_file" >/dev/null 2>&1; then
					error "🚨 Structural Error! '$base_name' is already tracked by Git, but alternate files (##) also exist.\n\
        👉 Please run: git mv \"$base_file\" \"${base_file}##default\"\n\
        Otherwise, future 'git pull' commands will result in conflicts!"
				fi

				info "  > Resolving priority: $base_name <- $(basename "$chosen_alt")"

				cp -f "$chosen_alt" "$base_file"

				# Ensure generated base file is ignored locally by Git
				local rel_target="${base_file#$DOTFILES_DIR/}"
				local exclude_file="$DOTFILES_DIR/.git/info/exclude"

				mkdir -p "$(dirname "$exclude_file")"
				[ -f "$exclude_file" ] || touch "$exclude_file"

				if ! grep -Fxq "$rel_target" "$exclude_file"; then
					echo "$rel_target" >>"$exclude_file"
					info "    (‼️ Added $rel_target to git exclude)"
				fi

				match_count=$((match_count + 1))
			fi

		done < <(
			# Extract base filenames by stripping everything after '##', then sort & deduplicate
			find "$dir" -type f -name "*##*" -print0 2>/dev/null |
				while IFS= read -r -d '' file; do
					printf "%s\0" "${file%%##*}"
				done | sort -z -u
		)
	done

	# Output summary
	if [ "$match_count" -eq 0 ]; then
		info "  >⚠️ No alternate files (*##*) found. Using default configs."
	else
		success "  >✅ Successfully prepared $match_count dynamically resolved file(s)."
	fi
}

link_librewolf_css() {
	local lw_config_dir="$HOME/.config/librewolf/librewolf"
	local dotfiles_chrome_src="$DOTFILES_DIR/modules/librewolf/chrome"

	if [ -d "$lw_config_dir" ] && [ -d "$dotfiles_chrome_src" ]; then
		info "🔗 Linking LibreWolf chrome to random profile(s)..."

		# 尋找所有以 .default-default 結尾的資料夾
		for profile in "$lw_config_dir"/*.default-default; do
			[ -d "$profile" ] || continue

			info "  > Target profile: $(basename "$profile")"

			local target="$profile/chrome"
			info "  > Target profile: $(basename "$profile")"
			if [ -L "$target" ] || [ -e "$target" ]; then
				rm -rf "$target"
			fi

			# 建立符號連結，使用 -sf 確保重複執行時會覆蓋
			ln -sf "$dotfiles_chrome_src" "$profile/chrome"
		done
		success "✅ LibreWolf chrome linked."
	else
		warn "⚠️ LibreWolf config or dotfiles source not found, skipping link."
	fi
}

link_firefox_css() {
	local config_dir="$HOME/.mozilla/firefox"
	local dotfiles_chrome_src="$DOTFILES_DIR/modules/firefox/chrome"

	if [ -d "$config_dir" ] && [ -d "$dotfiles_chrome_src" ]; then
		info "🔗 Linking Firefox chrome to random profile(s)..."

		# 尋找所有以 .default-release 結尾的資料夾
		for profile in "$config_dir"/*.default-release; do
			[ -d "$profile" ] || continue

			info "  > Target profile: $(basename "$profile")"

			local target="$profile/chrome"
			info "  > Target profile: $(basename "$profile")"
			if [ -L "$target" ] || [ -e "$target" ]; then
				rm -rf "$target"
			fi

			# 建立符號連結，使用 -sf 確保重複執行時會覆蓋
			ln -sf "$dotfiles_chrome_src" "$profile/chrome"
		done
		success "✅ Firefox chrome linked."
	else
		warn "⚠️ Firefox config or dotfiles source not found, skipping link."
	fi
}

cleanup_orphans() {
	info "Cleaning up broken symlinks in ~/.config and ~/.local/private..."
	# 尋找目錄下指向 dotfiles 但原始檔案已不存在的斷頭連結並刪除
	# -L 是找連結，! -e 是找指向目標不存在的
	find "$HOME/.config" "$HOME/.local/private" -xtype l -delete 2>/dev/null || true

	# 清理空目錄
	find "$HOME/.config" "$HOME/.local/private" -type d -empty -delete 2>/dev/null || true
}

stow_dotfiles() {
	cleanup_orphans

	local skip_pkgs=(
		"firefox"
		"librewolf"
	)

	# Directories that system might auto-create, so we force-delete them
	# before stowing to avoid "already exists" errors.
	local force_dirs=(
		"$HOME/.config/gtk-3.0"
		"$HOME/.config/gtk-4.0"
	)

	for dir in "${force_dirs[@]}"; do
		if [ -d "$dir" ] && [ ! -L "$dir" ]; then
			info "  > Removing pre-existing directory to allow stow: $dir"
			rm -rf "$dir"
		fi
	done

	local sources=(
		"modules"
		"private/modules"
	)

	info "Stowing dotfiles from: $DOTFILES_DIR"

	for source in "${sources[@]}"; do
		if [ ! -d "$source" ]; then
			if [[ "$source" == *"private"* ]]; then
				warn "  ! Skipping $source (directory not found, skipping private configs)"
			else
				error "Source directory '$source' not found!"
			fi
			continue
		fi

		info "Stowing packages from: $source"

		for pkg in "$source"/*; do
			[ -d "$pkg" ] || continue
			local pkg_name=$(basename "$pkg")

			if [[ " ${skip_pkgs[*]} " =~ " ${pkg_name} " ]]; then
				info "  > Skipping: $pkg_name"
				continue
			fi

			info "  > Stowing: $pkg_name"
			stow -d "$source" -t "$HOME" --restow --no-folding "$pkg_name"
		done
	done

	success "✅ All dotfiles stowed successfully."
}

main() {
	check_command git stow
	prepare_host_files
	stow_dotfiles

	link_librewolf_css
	link_firefox_css

	if command -v systemctl >/dev/null; then
		info "Reloading systemd user daemon..."
		systemctl --user daemon-reload
	fi

	success "🎉 Dotfiles deployment completed!"
}

main "$@"
