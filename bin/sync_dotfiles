#!/bin/bash

# ==============================================================================
# Stow Dotfiles Deployment Script
# ==============================================================================
set -euo pipefail

# use BASH_SOURCE to get the script actual path
# SCRIPT_DIR will be: ~/dotfiles/bin
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# root path (e.g., ~/dotfiles)
DOTFILES_DIR="$(dirname "$SCRIPT_DIR")"

source "$DOTFILES_DIR/lib/common"

cd_or_error "$DOTFILES_DIR"

prepare_host_files() {
	local current_host
	if command -v hostname >/dev/null 2>&1; then
		current_host=$(hostname)
	elif [ -f /etc/hostname ]; then
		current_host=$(cat /etc/hostname)
	else
		current_host=$(uname -n)
	fi

	# Fallback if still empty
	[ -z "$current_host" ] && current_host="unknown"

	local current_os
	current_os=$(uname -s)

	info "🏠 Detected system: Hostname=[$current_host], OS=[$current_os]"

	# Prompt user to verify the target hostname
	if ! confirm "Is this the correct hostname for deployment?"; then
		read -rp "Please enter the target hostname manually: " custom_host
		if [ -z "$custom_host" ]; then
			error "Hostname cannot be empty. Aborting deployment."
		fi
		current_host="$custom_host"
		info "🏠 Overriding target hostname to: $current_host"
	fi

	# ==========================================================================
	# Alternate File Priorities (Highest to Lowest)
	# ==========================================================================
	local priorities=(
		"hostname.${current_host}"
		"os.${current_os}"
		"default"
	)

	local search_dirs=(
		"$DOTFILES_DIR/modules"
		"$DOTFILES_DIR/private/modules"
	)

	local match_count=0

	for dir in "${search_dirs[@]}"; do
		[ -d "$dir" ] || continue

		# # Find all alternate files containing '##' and extract unique base file paths
		while IFS= read -r -d '' base_file; do
			local chosen_alt=""
			local base_name="$(basename "$base_file")"

			# Evaluate suffix rules in order of priority
			for suffix in "${priorities[@]}"; do
				if [ -f "${base_file}##${suffix}" ]; then
					chosen_alt="${base_file}##${suffix}"
					break # 找到最高優先權的檔案就立刻跳出迴圈！
				fi
			done

			# Process matched alternate file
			if [ -n "$chosen_alt" ]; then
				# Prevent structural conflict: Base file must not be tracked in Git
				if git ls-files --error-unmatch "$base_file" >/dev/null 2>&1; then
					error "🚨 Structural Error! '$base_name' is already tracked by Git, but alternate files (##) also exist.\n\
        👉 Please run: git mv \"$base_file\" \"${base_file}##default\"\n\
        Otherwise, future 'git pull' commands will result in conflicts!"
				fi

				info "  > Resolving priority: $base_name <- $(basename "$chosen_alt")"

				cp -f "$chosen_alt" "$base_file"

				# Ensure generated base file is ignored locally by Git
				local rel_target="${base_file#$DOTFILES_DIR/}"
				local exclude_file="$DOTFILES_DIR/.git/info/exclude"

				mkdir -p "$(dirname "$exclude_file")"
				[ -f "$exclude_file" ] || touch "$exclude_file"

				if ! grep -Fxq "$rel_target" "$exclude_file"; then
					echo "$rel_target" >>"$exclude_file"
					info "    (‼️ Added $rel_target to git exclude)"
				fi

				match_count=$((match_count + 1))
			fi

		done < <(
			# Extract base filenames by stripping everything after '##', then sort & deduplicate
			find "$dir" -type f -name "*##*" -print0 2>/dev/null |
				while IFS= read -r -d '' file; do
					printf "%s\0" "${file%%##*}"
				done | sort -z -u
		)
	done

	# Output summary
	if [ "$match_count" -eq 0 ]; then
		info "  >⚠️ No alternate files (*##*) found. Using default configs."
	else
		success "  >✅ Successfully prepared $match_count dynamically resolved file(s)."
	fi
}

# link_browser_chrome <name> <profiles_dir> <profile_glob> <chrome_src>
# Link the dotfiles chrome/ (userChrome.css etc.) into every matching profile.
# An existing symlink is replaced; a real chrome/ directory is backed up to
# chrome.bak-<timestamp> instead of being deleted.
link_browser_chrome() {
	local name="$1" profiles_dir="$2" profile_glob="$3" chrome_src="$4"

	if [ ! -d "$profiles_dir" ] || [ ! -d "$chrome_src" ]; then
		warn "⚠️ $name config or dotfiles source not found, skipping link."
		return 0
	fi

	info "🔗 Linking $name chrome to profile(s)..."
	local profile target backup
	for profile in "$profiles_dir"/$profile_glob; do
		[ -d "$profile" ] || continue
		target="$profile/chrome"
		info "  > Target profile: $(basename "$profile")"

		if [ -L "$target" ]; then
			rm -f "$target"
		elif [ -e "$target" ]; then
			backup="$target.bak-$(date +%Y%m%d-%H%M%S)"
			warn "  ! Existing chrome/ is not a symlink, backing up to: $backup"
			mv "$target" "$backup"
		fi

		ln -s "$chrome_src" "$target"
	done
	success "✅ $name chrome linked."
}

link_librewolf_css() {
	link_browser_chrome "LibreWolf" "$HOME/.config/librewolf/librewolf" \
		"*.default-default" "$DOTFILES_DIR/modules/librewolf/chrome"
}

link_firefox_css() {
	link_browser_chrome "Firefox" "$HOME/.mozilla/firefox" \
		"*.default-release" "$DOTFILES_DIR/modules/firefox/chrome"
}

cleanup_orphans() {
	info "Cleaning up broken dotfiles symlinks..."
	# 只刪「指向 dotfiles、但目標已不存在」的斷頭連結(例如測試後改名或刪除的檔案)。
	# 其他程式自己的斷頭連結不能動，例如 Electron/Chromium 的 SingletonLock
	# 本來就指向不存在的路徑，刪掉會讓程式偵測不到執行中的實例。
	local dotfiles_real
	dotfiles_real=$(realpath "$DOTFILES_DIR")

	local roots=(
		"$HOME/.config"
		"$HOME/.local/bin"
		"$HOME/.local/share"
		"$HOME/.local/private"
	)

	local link target dir
	while IFS= read -r -d '' link; do
		target=$(readlink -m "$link")
		[[ "$target" == "$dotfiles_real/"* ]] || continue

		info "  > Removing broken link: $link"
		rm -f "$link"

		# 只清掉因為刪除連結而變空的上層目錄，停在 roots / $HOME
		dir=$(dirname "$link")
		while [[ "$dir" != "$HOME" && ! " ${roots[*]} " =~ " $dir " ]] &&
			rmdir "$dir" 2>/dev/null; do
			dir=$(dirname "$dir")
		done
	done < <(
		find "${roots[@]}" -xtype l -print0 2>/dev/null
		find "$HOME" -maxdepth 1 -xtype l -print0 2>/dev/null
	)
}

stow_dotfiles() {
	cleanup_orphans

	local skip_pkgs=(
		"firefox"
		"librewolf"
	)

	# Packages whose files the system or apps may create as real files
	# (e.g. gtk settings.ini), which makes stow fail with "already exists".
	# Back up only those conflicting files; never delete the whole directory,
	# since it also holds untracked files such as matugen's colors.css.
	local conflict_pkgs=(
		"gtk-3.0"
		"gtk-4.0"
	)
	local stamp
	stamp=$(date +%Y%m%d-%H%M%S)

	for pkg_name in "${conflict_pkgs[@]}"; do
		[ -d "modules/$pkg_name" ] || continue
		while IFS= read -r -d '' src; do
			local rel="${src#modules/$pkg_name/}"
			local dest="$HOME/$rel"
			if [ -e "$dest" ] && [ ! -L "$dest" ]; then
				info "  > Backing up conflicting file: $dest -> $dest.bak-$stamp"
				mv "$dest" "$dest.bak-$stamp"
			fi
		done < <(find "modules/$pkg_name" -type f -print0)
	done

	local sources=(
		"modules"
		"private/modules"
	)

	info "Stowing dotfiles from: $DOTFILES_DIR"

	for source in "${sources[@]}"; do
		if [ ! -d "$source" ]; then
			if [[ "$source" == *"private"* ]]; then
				warn "  ! Skipping $source (directory not found, skipping private configs)"
			else
				error "Source directory '$source' not found!"
			fi
			continue
		fi

		info "Stowing packages from: $source"

		for pkg in "$source"/*; do
			[ -d "$pkg" ] || continue
			local pkg_name=$(basename "$pkg")

			if [[ " ${skip_pkgs[*]} " =~ " ${pkg_name} " ]]; then
				info "  > Skipping: $pkg_name"
				continue
			fi

			info "  > Stowing: $pkg_name"
			stow -d "$source" -t "$HOME" --restow --no-folding "$pkg_name"
		done
	done

	success "✅ All dotfiles stowed successfully."
}

main() {
	check_command git stow
	prepare_host_files
	stow_dotfiles

	link_librewolf_css
	link_firefox_css

	if command -v systemctl >/dev/null; then
		info "Reloading systemd user daemon..."
		systemctl --user daemon-reload
	fi

	success "🎉 Dotfiles deployment completed!"
}

main "$@"
