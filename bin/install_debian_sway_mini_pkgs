echo "=== [8/9] Sync TMUX configs ==="

TMUX_CONFIG_PATH="$HOME/.tmux.conf"
cat <<'EOF' >"$TMUX_CONFIG_PATH"
# -----------------------------
# Global settings
# -----------------------------
set-environment -g LC_TIME en_US.UTF-8

set -g default-terminal "tmux-256color"
set -as terminal-features ",tmux-256color:RGB"
set -as terminal-features ',xterm*:clipboard'
# set -as terminal-features ",xterm-kitty:RGB"

set -ga update-environment TERM
set -ga update-environment TERM_PROGRAM

set -g pane-border-style bg=default
set -g pane-active-border-style bg=default
set -g status-style bg=default
set -g window-style bg=default
set -g window-active-style bg=default
set -sg escape-time 0
set -g history-limit 30000
set -g bell-action any
set -g display-time 4000
set -g status-interval 1
set -g base-index 1
set -g pane-base-index 1
setw -g xterm-keys on
setw -g automatic-rename off
set -g set-titles on
set -g focus-events on
setw -g aggressive-resize on
set -g status on
set -g status-left-length 99
set -g status-right-length 99
set -g status-justify absolute-centre

set-window-option -g pane-base-index 1
set-option -g renumber-windows on

SET_DEFAULT_SHELL='tmux set-option -g default-shell $TMUX_DEFAULT_SHELL'
if-shell '[ -n "$TMUX_DEFAULT_SHELL" ]' \
  "run-shell '${SET_DEFAULT_SHELL}'"

# -----------------------------
# key bindings
# -----------------------------

unbind c-b

set -g prefix C-a
set -g mouse on

# bind R source-file "$HOME/.tmux.conf"
bind R source-file "$HOME/.tmux.conf" \; display-message "✅ Tmux configuration reloaded!"

# bind prefix v and s for split windows
unbind %
unbind '"'
bind v split-window -h -c "#{pane_current_path}"
bind s split-window -v -c "#{pane_current_path}"

# put w to sessions instead of windows
bind a choose-session

# Windows navigation using shift alt vim keys
bind-key -n 'M-H' previous-window
bind-key -n 'M-L' next-window
bind -n M-1 select-window -t 1
bind -n M-2 select-window -t 2
bind -n M-3 select-window -t 3
bind -n M-4 select-window -t 4
bind -n M-5 select-window -t 5
bind -n M-6 select-window -t 6
bind -n M-7 select-window -t 7
bind -n M-8 select-window -t 8
bind -n M-9 select-window -t 9

# Kill all other panes without the current pane and no confirmation
bind-key q kill-pane -a

# Smart pane switching with awareness of Vim splits.
# See: https://github.com/christoomey/vim-tmux-navigator
vim_pattern='(\S+/)?g?\.?(view|l?n?vim?x?|fzf)(diff)?(-wrapped)?'
is_vim="ps -o state= -o comm= -t '#{pane_tty}' \ | grep -iqE '^[^TXZ ]+ +${vim_pattern}$'"
bind-key -n 'C-h' if-shell "$is_vim" 'send-keys C-h'  'select-pane -L'
bind-key -n 'C-j' if-shell "$is_vim" 'send-keys C-j'  'select-pane -D'
bind-key -n 'C-k' if-shell "$is_vim" 'send-keys C-k'  'select-pane -U'
bind-key -n 'C-l' if-shell "$is_vim" 'send-keys C-l'  'select-pane -R'
tmux_version='$(tmux -V | sed -En "s/^tmux ([0-9]+(.[0-9]+)?).*/\1/p")'
if-shell -b '[ "$(echo "$tmux_version < 3.0" | bc)" = 1 ]' \
    "bind-key -n 'C-\\' if-shell \"$is_vim\" 'send-keys C-\\'  'select-pane -l'"
if-shell -b '[ "$(echo "$tmux_version >= 3.0" | bc)" = 1 ]' \
    "bind-key -n 'C-\\' if-shell \"$is_vim\" 'send-keys C-\\\\'  'select-pane -l'"

# Pane navigation in copy mode
bind-key -T copy-mode-vi 'C-h' select-pane -L
bind-key -T copy-mode-vi 'C-j' select-pane -D
bind-key -T copy-mode-vi 'C-k' select-pane -U
bind-key -T copy-mode-vi 'C-l' select-pane -R
bind-key -T copy-mode-vi 'C-\' select-pane -l

# Increase/decrease pane size
# bind-key = resize-pane -L 10
# bind-key - resize-pane -R 10
bind-key -r H resize-pane -L 5
bind-key -r J resize-pane -D 5
bind-key -r K resize-pane -U 5
bind-key -r L resize-pane -R 5

# Clipboard Support
# 允許 tmux 透過 OSC 52 序列與外部剪貼簿通訊
set-option -g set-clipboard on
set-window-option -g mode-keys vi

bind -T copy-mode-vi y send-keys -X copy-selection-and-cancel
bind -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel
# Expand the OSC 52 sequence to support more terminal emulators, including VTE-based ones like GNOME Terminal and Alacritty
set -ag terminal-overrides ",alacritty:Ms=\\E]52;c;%p2%s\\7"
set -ag terminal-overrides ",xterm-kitty:Ms=\\E]52;c;%p2%s\\7"
set -ag terminal-overrides ",ghostty:Ms=\\E]52;c;%p2%s\\7"
set -ag terminal-overrides ",foot:Ms=\\E]52;c;%p2%s\\7"
set -ag terminal-overrides ",xterm*:Ms=\\E]52;c;%p2%s\\7"
set -ag terminal-overrides ",screen*:Ms=\\E]52;c;%p2%s\\7"
set -ag terminal-overrides ",tmux*:Ms=\\E]52;c;%p2%s\\7"
set -ag terminal-overrides ",vte*:Ms=\\E]52;c;%p2%s\\7" # GNOME Terminal, XFCE Terminal, Tilix, Guake and other VTE-based terminals

# Enable copy mode with 'k'
unbind [
bind-key k copy-mode

# Selection modes in copy mode
bind -T copy-mode-vi v send-keys -X begin-selection
bind -T copy-mode-vi V send-keys -X select-line
bind -T copy-mode-vi C-v send-keys -X select-block

# Debug level
set -g @debug-level 1

# New session and switch to it
bind-key c new-window -c "#{pane_current_path}"

# forget the find window.  That is for chumps
bind-key -r f run-shell "tmux neww ~/.local/bin/byte4work-tmux-sessionizer"

# kitty neovim markdown image.lua preview
set -gq allow-passthrough on
set -g visual-activity off
EOF

echo "=== [9/9] Sync Scripts ==="

SCRIPTS_FOLDER="$HOME/.local/bin"
cat <<'EOF' >"$SCRIPTS_FOLDER/byte4work-tmux-sessionizer"
#!/usr/bin/env bash

# === Config ===
SEARCH_DIRS=(
	"${HOME}/Development/personal"
	"${HOME}/Development/side_projects"
	"${HOME}/Development/learning"
	"${HOME}/Development/devops"
	"${HOME}/Development/open_source"

	"${HOME}/Development/working/backend"
	"${HOME}/Development/working/web"
	"${HOME}/Development/working/app"
	"${HOME}/Development/working/cli"
)

SESSIONIZER_LOG="$HOME/.local/bin/logs/tmux-sessionizer.log"

log() {
	echo "$(date +'%F %T') - $*" | tee -a "$SESSIONIZER_LOG"
}

run_tmux() {
	TMUX= command tmux "$@"
}

# === FZF-based project picker ===
pick_project() {
	local selected
	local extra_repos=(
		"${HOME}/dotfiles"
		"${HOME}/Development"
		# Add more fixed paths if you want
	)

	selected=$(
		{
			# Print each extra repo if it exists and is a directory
			for repo in "${extra_repos[@]}"; do
				[ -d "$repo" ] && echo "$repo"
			done
			# Then print the normal search results
			find "${SEARCH_DIRS[@]}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null
		} | sort | uniq |
			fzf --height=40% --reverse --prompt="📁 Pick a project > " \
				--preview 'tree -L 1 {} | head -100' \
				--preview-window=right:50%
	)

	[[ -z "$selected" ]] && exit 1
	echo "$selected"
}

# === Main logic ===
PROJECT_DIR="$1"
if [[ -z "$PROJECT_DIR" ]]; then
	# log "Launching fzf to pick a project..."
	PROJECT_DIR=$(pick_project)
fi

# log "DEBUG: Raw PROJECT_DIR is: '$PROJECT_DIR'"

PROJECT_NAME="$(basename "$PROJECT_DIR")"
# log "Selected project: $PROJECT_NAME at $PROJECT_DIR"
# log "DEBUG: Calculated PROJECT_NAME is: '$PROJECT_NAME'"
# log "DEBUG: PROJECT_NAME length is: ${#PROJECT_NAME}"

# Check if session exists
if run_tmux has-session -t="$PROJECT_NAME" 2>/dev/null; then
	# log "Session $PROJECT_NAME already exists."
	if [[ -n "$TMUX" ]]; then
		# log "Inside tmux, switching client..."
		run_tmux switch-client -t "$PROJECT_NAME" || {
			# log "[warn] switch-client failed, creating new window..."
			run_tmux new-window -t "$PROJECT_NAME" -c "$PROJECT_DIR"
		}
	else
		# log "Outside tmux, attaching..."
		run_tmux attach-session -t "$PROJECT_NAME"
	fi
	exit 0
fi

# Create session
# log "Creating session $PROJECT_NAME..."
run_tmux new-session -d -s "$PROJECT_NAME" -c "$PROJECT_DIR"

# Wait a bit to catch any immediate exit
sleep 0.2
if ! run_tmux has-session -t="$PROJECT_NAME" 2>/dev/null; then
	# log "[fatal] Session vanished. Shell likely exited immediately."
	# log "[hint] Check shell rc files (.zshrc/.bashrc) for early exits."
	exit 1
fi

# Switch or attach
if [[ -n "$TMUX" ]]; then
	# log "Inside tmux, switching..."
	run_tmux switch-client -t "$PROJECT_NAME"
else
	# log "Outside tmux, attaching..."
	run_tmux attach-session -t "$PROJECT_NAME"
fi
EOF
chmod +x "$SCRIPTS_FOLDER/byte4work-tmux-sessionizer"

cat <<'EOF' >"$SCRIPTS_FOLDER/byte4work-wofi-clipboard"
#!/bin/bash

selected=$(cliphist list | wofi --dmenu --allow-images --prompt "Clipboard" --width 800 --height 600)
[ -z "$selected" ] && exit 0
echo "$selected" | cliphist decode | wl-copy
notify-send "Cliphist" "Copy to Clipboard" -t 1000
EOF

chmod +x "$SCRIPTS_FOLDER/byte4work-wofi-clipboard"

show_cli_multi_menu

echo "=================================================="
echo "🎉 Sway environment and configuration setup complete!"
echo "Configuration file written to: ~/.config/sway/config"
echo "You can now log out, switch to the Sway session, and create your snapshot!"
echo "=================================================="
