[user]
	name = yimintsai
	email = byte4cat@gmail.com
	signingkey = 7DE0B627750BE9BDC010CA679D530A65D5E87608

[alias]
    co = checkout
    br = branch
    st = status
    l = log --oneline --graph
	aa = add --all
	cm = commit -m
    acm = !git add --all && git commit -m
    undo = reset --soft HEAD~1
	sign = commit --amend --no-edit -S
    graph = log --oneline --graph --decorate
	l = log --graph --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]%C(auto)[%G?]"
	ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]%C(auto)[%G?]" --decorate
    ll = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]%C(auto)[%G?]" --decorate --numstat
    lds = log --pretty=format:"%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%cn]%C(auto)[%G?]" --decorate --date=short
	lgpg = log --show-signature --graph --pretty=format:"%C(yellow)%h%C(reset)\\ :\\ %s\\ %C(blue)<%an>%C(reset)"
	conflicts = diff --name-only --diff-filter=U
	local-branches = !git branch -vv | cut -c 3- | awk '$3 !~/\\[/ { print $1 }'
	recent-branches = !git branch --sort=-committerdate | head
	authors = shortlog -sn --all
	sign = commit --amend --no-edit -S

[core]
    editor = vim
    autocrlf = input
	excludesfile = ~/.gitignore_global
	pager = delta

[init]
	defaultBranch = main

[pull]
    rebase = true

[includeIf "gitdir:/Users/"]
    path = ~/.gitconfig_macos

[includeIf "gitdir:/home/"]
    path = ~/.gitconfig_linux
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[commit]
	gpgsign = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
[merge]
	conflictstyle = diff3
[push]
	autoSetupRemote = true
