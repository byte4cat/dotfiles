xwayland enable

# --- 變數定義 ---
set $my_path $HOME/.local/bin/sway:$HOME/.local/bin/wayland:$HOME/.local/private/bin:$PATH
set $mainMod Mod4
set $secMod Mod1
set $terminal PATH=$my_path ghostty
set $browser librewolf
set $menu wofi --show drun
set $file_manager thunar
set $PRIMARY_MONITOR DP-1

# --- 自動啟動 ---
exec_always --no-startup-id dbus-update-activation-environment PATH=$my_path DISPLAY I3SOCK SWAYSOCK WAYLAND_DISPLAY WLR_RENDERER XDG_CURRENT_DESKTOP
exec_always gpg-connect-agent updatestartuptty /bye
exec_always gnome-keyring-daemon --start --components=secrets,pkcs11,ssh
exec_always awww-daemon
exec_always wl-paste --watch cliphist store
exec_always pkill waybar; PATH=$my_path byte4work-launch-waybar
exec_always pkill swaync; swaync
exec_always fcitx5 -d
exec_always pkill swayosd-server; swayosd-server

exec awww img ~/.local/share/wallpapers/wp14362312-linux-minimalist-wallpapers.jpg
exec --no-startup-id signal-desktop
exec --no-startup-id vesktop

# --- 閒置與鎖定設定 ---
# 說明：
# - 閒置 5 秒：隱藏滑鼠游標。
# - 閒置 300 秒(5分鐘): 啟動帶有特效的鎖定畫面。
# - 閒置 600 秒(10分鐘): 關閉螢幕電源(DPMS)。
# - 恢復時：觸發輕微移動以喚醒游標。
# 定義鎖定指令變數:
set $lock_cmd 'swaylock --screenshots --clock --indicator --indicator-radius 100 --indicator-thickness 7 --effect-blur 7x5 --effect-vignette 0.5:0.5 --ring-color 3b4252 --key-hl-color 88c0d0 --inside-color 2e344088 --separator-color 00000000 --font "JetBrainsMono Nerd Font" --text-color d8dee9'

exec swayidle -w \
    timeout 5 'swaymsg seat seat0 hide_cursor 5000' \
    resume 'swaymsg seat seat0 cursor move 0 0' \
    timeout 300 $lock_cmd \
    timeout 600 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    before-sleep $lock_cmd

# 設定視窗間隙 (Gaps)
gaps inner 10
gaps outer 5

# 設定智慧型間隙 (如果只有一個視窗則關閉間隙)
smart_gaps on
smart_borders on

# -- auto apps --
exec swaymsg 'workspace 1; exec $terminal'
exec swaymsg 'workspace 2; exec $browser'
exec swaymsg 'workspace 0; exec $browser'

# --- 外觀設定 ---
exec gsettings set org.gnome.desktop.interface color-scheme prefer-dark
exec gsettings set org.gnome.desktop.interface font-name "sans-serif 11"

client.focused          #87CEFA #444444 #ffffff #87CEFA #87CEFA
client.focused_inactive #333333 #222222 #888888 #333333 #333333
client.unfocused        #222222 #222222 #444444 #222222 #222222

# 將所有新開啟的視窗預設為只有邊框，且寬度為 2 像素
default_border pixel 2
default_floating_border pixel 2

# --- hot reload ---
bindsym $mainMod+Shift+c reload

# --- 輸出設定 ---
output HDMI-A-1 {
    mode 1920x1200@60Hz
	adaptive_sync on
	dpms on
    transform 270
    pos 0 0
}
output DP-1 {
    mode 3840x2160@60Hz
	adaptive_sync on
	dpms on
    scale 1.5
    pos 1200 0
}

# --- 工作區綁定 ---
workspace 1 output DP-1
workspace 2 output DP-1
workspace 3 output DP-1
workspace 4 output DP-1
workspace 5 output DP-1
workspace 6 output DP-1
workspace 7 output DP-1
workspace 8 output DP-1
workspace 9 output DP-1
workspace 10 output HDMI-A-1

workspace 2 layout tabbed
for_window [workspace="2"] layout tabbed

# --- 視窗規則 ---
assign [class="Signal"] workspace "sw_signal"
assign [class="vesktop"] workspace "sw_vesktop"

for_window [class="^.*$"] opacity 0.96
for_window [app_id="^(firefox|brave-browser|librewolf)$"] opacity 1.0
for_window [class="^(vesktop|Signal)$"] opacity 1.0
for_window [app_id="com.mitchellh.ghostty"] opacity 0.80
for_window [app_id="walker"] floating enable, border none, focus, move center
for_window [app_id="wofi"] floating enable, move center, focus
for_window [app_id="waypaper"] floating enable, move center, focus
for_window [app_id="com.mitchellh.ghostty" title="spotify-player"] {
    floating enable
    move position center
    move scratchpad
}
for_window [app_id="com.mitchellh.ghostty" title="scratchpad-term"] {
    floating enable
    move position center
    move scratchpad
}
for_window [app_id="satty"] {
    floating enable
    border none
    sticky enable
    resize set 800 600
    move position center
}
for_window [con_mark="browser_auto"] {
    move container to workspace 2
	# not move to workspace 2, but set the layout of workspace 2 to tabbed and unmark the container
    # workspace 2 
    layout tabbed
    unmark browser_auto
}

# 進入 resize 模式
bindsym $mainMod+r mode "resize"

mode "resize" {
    # 透過方向鍵調整大小
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt

    # 回到預設模式
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# --- 視窗控制 ---
bindsym $mainMod+Shift+f floating toggle
bindsym $mainMod+f fullscreen toggle

# Vim Style 焦點與移動
bindsym $mainMod+h focus left
bindsym $mainMod+j focus down
bindsym $mainMod+k focus up
bindsym $mainMod+l focus right

bindsym $mainMod+Shift+h move left
bindsym $mainMod+Shift+j move down
bindsym $mainMod+Shift+k move up
bindsym $mainMod+Shift+l move right

# 工作區切換 1-10
bindsym $mainMod+1 workspace number 1
bindsym $mainMod+2 workspace number 2
bindsym $mainMod+3 workspace number 3
bindsym $mainMod+4 workspace number 4
bindsym $mainMod+5 workspace number 5
bindsym $mainMod+6 workspace number 6
bindsym $mainMod+7 workspace number 7
bindsym $mainMod+8 workspace number 8
bindsym $mainMod+9 workspace number 9
bindsym $mainMod+0 workspace number 10

# 移動視窗到工作區
bindsym $mainMod+Shift+1 move container to workspace number 1
bindsym $mainMod+Shift+2 move container to workspace number 2
bindsym $mainMod+Shift+3 move container to workspace number 3
bindsym $mainMod+Shift+4 move container to workspace number 4
bindsym $mainMod+Shift+5 move container to workspace number 5
bindsym $mainMod+Shift+6 move container to workspace number 6
bindsym $mainMod+Shift+7 move container to workspace number 7
bindsym $mainMod+Shift+8 move container to workspace number 8
bindsym $mainMod+Shift+9 move container to workspace number 9
bindsym $mainMod+Shift+0 move container to workspace number 10

# --- 聲音與媒體 (SwayOSD) ---
bindsym --release XF86AudioRaiseVolume exec "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ && swayosd-client --output-volume raise --monitor $PRIMARY_MONITOR"
bindsym --release XF86AudioLowerVolume exec "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && swayosd-client --output-volume lower --monitor $PRIMARY_MONITOR"
bindsym --release XF86AudioMute exec "swayosd-client --output-volume mute-toggle --monitor $PRIMARY_MONITOR"
bindsym --release XF86AudioMicMute exec "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle && swayosd-client --input-volume mute-toggle --monitor $PRIMARY_MONITOR"

# --- 聲音控制 (Mod + [ / ]) ---
bindsym $mainMod+bracketright exec "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ && swayosd-client --output-volume raise --monitor $PRIMARY_MONITOR"
bindsym $mainMod+bracketleft exec "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && swayosd-client --output-volume lower --monitor $PRIMARY_MONITOR"
bindsym $mainMod+backslash exec "swayosd-client --output-volume mute-toggle --monitor $PRIMARY_MONITOR"
# Mute 麥克風
bindsym $mainMod+Shift+backslash exec "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle && swayosd-client --input-volume mute-toggle --monitor $PRIMARY_MONITOR"

# --- 亮度 ---
bindsym XF86MonBrightnessUp exec "brightnessctl set 5%+ && swayosd-client --brightness raise"
bindsym XF86MonBrightnessDown exec "brightnessctl set 5%- && swayosd-client --brightness lower"

bindsym $mainMod+Return exec $terminal
bindsym $mainMod+q kill
# bindsym $mainMod+b exec $browser
# 使用 --mark 參數標記該視窗，然後移動到 workspace 2
bindsym $mainMod+b exec $browser --new-window; \
    exec swaymsg '[app_id="librewolf"] mark --add browser_auto'
bindsym $mainMod+Shift+e exec $file_manager
bindsym $mainMod+m exec pgrep wofi && pkill wofi || PATH=$my_path byte4work-wofi-power-menu

# 特殊工作區
bindsym $mainMod+x exec PATH=$my_path byte4work-toggle-signal-workspace
bindsym $mainMod+Shift+x move container to workspace "sw_signal"; workspace "sw_signal"
bindsym $mainMod+s exec PATH=$my_path byte4work-toggle-vesktop-workspace
bindsym $mainMod+Shift+s move container to workspace "sw_vesktop"; workspace "sw_vesktop"

# Scratchpad
bindsym $mainMod+a exec PATH=$my_path byte4work-toggle-scratch-term-workspace
bindsym $mainMod+v exec PATH=$my_path byte4work-toggle-music-workspace

# Waybar
bindsym $mainMod+Shift+t exec PATH=$my_path byte4work-wofi-switch-waybar-theme

# 啟動器與工具
bindsym $mainMod+d exec pgrep wofi && pkill wofi || XDG_DATA_DIRS=$HOME/.local/share:$XDG_DATA_DIRS PATH=$my_path wofi --show drun
bindsym $mainMod+t exec PATH=$my_path byte4work-switch-waybar-theme; exec swaymsg focus
bindsym $mainMod+n cyclenext
bindsym $mainMod+Shift+n exec swaync-client -t

# --- 快速選單 ---
bindsym $mainMod+c exec pgrep wofi && pkill wofi || PATH=$my_path byte4work-wofi-quick-menu
bindsym $mainMod+$secMod+c exec PATH=$my_path byte4work-wofi-clipboard
bindsym $mainMod+w exec PATH=$my_path byte4work-waypaper-selector; exec swaymsg focus
bindsym $mainMod+Shift+b exec PATH=$my_path byte4work-babycam

# --- Screenshot ---
# 截圖整個螢幕 (Ctrl+1)
bindsym $mainMod+Control+1 exec grim - | wl-copy && notify-send "Screenshot copied to clipboard"
# 截圖視窗 (Ctrl+2)
bindsym $mainMod+Control+2 exec grim -g "$(slurp)" - | wl-copy && notify-send "Screenshot copied to clipboard"
# 截圖區域 (Ctrl+3)
bindsym $mainMod+Control+3 exec grim -g "$(slurp)" - | wl-copy && notify-send "Screenshot copied to clipboard"

# --- Screenshot (Edit with Satty) ---
# 截圖整個螢幕並用 satty 編輯 (Ctrl+Shift+1)
bindsym $mainMod+Control+Shift+1 exec grim - | satty --filename - --fullscreen
# 截圖視窗並用 satty 編輯 (Ctrl+Shift+2)
bindsym $mainMod+Control+Shift+2 exec grim -g "$(slurp)" - | satty --filename -
# 截圖選取區域並用 satty 編輯 (Ctrl+Shift+3)
bindsym $mainMod+Control+Shift+3 exec grim -g "$(slurp)" - | satty --filename -

input "type:keyboard" {
    xkb_layout us
    xkb_options ctrl:nocaps
}

bar {
    swaybar_command swaybar

    # 設定顯示位置
    position top
    
    # 設定狀態列資訊 (預設使用 i3status)
    status_command i3status

    # 設定顏色 (這跟 waybar 的 css 完全不同，是這裡自己定義)

	# Nord
	colors {
    background #2e3440
    statusline #d8dee9
    focused_workspace #88c0d0 #88c0d0 #2e3440
    inactive_workspace #3b4252 #3b4252 #d8dee9
	}
}

include /home/neil/.local/private/sway/config
