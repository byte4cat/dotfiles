# --- 基礎模式 ---
mode=drun

# --- 幾何位置 ---
location=center
width=800
height=400

# --- 行為與外觀 ---
prompt=Search...
gtk_dark=true
allow_images=true
image_size=32
insensitive=true
allow_markup=true
no_actions=true
orientation=vertical
# 讓它在居中時更像一個彈出視窗
hide_search=false

key_up=Ctrl-k
key_down=Ctrl-j
key_left=Ctrl-h
key_right=Ctrl-l
