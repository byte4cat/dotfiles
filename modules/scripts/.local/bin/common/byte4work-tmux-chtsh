#!/usr/bin/env bash

# from: https://cht.sh/
# github: https://github.com/chubin/cheat.sh

languages=(
	golang
	solidity
	vlang
	v
	nodejs
	javascript
	tmux
	typescript
	zsh
	cpp
	c
	lua
	rust
	python
	bash
	php
	haskell
	ArnoldC
	css
	html
	gdb
)

commands=(
	find
	man
	tldr
	sed
	awk
	tr
	cp
	ls
	grep
	xargs
	rg
	ps
	mv
	kill
	lsof
	less
	head
	tail
	tar
	rm
	rename
	jq
	cat
	ssh
	cargo
	git
	git-worktree
	git-status
	git-commit
	git-rebase
	docker
	docker-compose
	stow
	chmod
	chown
	make
)

selected=$(printf "%s\n" "${languages[@]}" "${commands[@]}" | fzf)
if [[ -z $selected ]]; then
	exit 0
fi

read -r -p "Enter Query: " query
query=${query// /+}

if printf '%s\n' "${languages[@]}" | grep -qx "$selected"; then
	url="cht.sh/$selected/$query"
else
	url="cht.sh/$selected~$query"
fi

# Pass the URL as an argument instead of splicing it into the command string,
# so shell metacharacters in the query (; $() ` etc.) are never executed.
# shellcheck disable=SC2016
tmux neww bash -c 'echo "curl $1" && curl -s "$1" | less -R' _ "$url"
