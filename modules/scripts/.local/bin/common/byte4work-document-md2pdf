#!/usr/bin/env python

# deps
# sudo pacman -S --noconfirm --needed \
# 	python-markdown python-weasyprint python-pygments

import sys

import markdown
from pygments.formatters import HtmlFormatter
from weasyprint import HTML


def convert_md_to_a4_pdf(md_file, pdf_file):
    with open(md_file, "r", encoding="utf-8") as f:
        text = f.read()

    html_body = markdown.markdown(
        text, extensions=["fenced_code", "tables", "codehilite"]
    )

    # 將 'github' 改為 Pygments 內建支援的 'friendly' 風格
    pygments_css = HtmlFormatter(style="friendly").get_style_defs(".codehilite")

    html_content = f"""
    <!DOCTYPE html>
    <html>
    <head>
    <meta charset="utf-8">
    <style>
      @page {{
        size: A4;
        margin: 20mm;
        background-color: #ffffff;
      }}
      body {{
        font-family: "Noto Sans CJK TC", "WenQuanYi Micro Hei", sans-serif;
        color: #24292e;
        line-height: 1.6;
        font-size: 11pt;
        margin: 0;
        padding: 0;
      }}
      h1, h2, h3 {{
        border-bottom: 1px solid #eaecef;
        padding-bottom: .3em;
        color: #0366d6;
        margin-top: 24px;
      }}
      h1 {{ font-size: 2em; }}
      h2 {{ font-size: 1.5em; }}
      code {{
        font-family: SFMono-Regular, Consolas, "Liberation Mono", monospace;
        background-color: rgba(27,31,35,0.05);
        padding: 0.2em 0.4em;
        border-radius: 3px;
        font-size: 85%;
      }}
      pre {{
        background-color: #f6f8fa;
        border-radius: 6px;
        padding: 16px;
        overflow: auto;
        font-family: SFMono-Regular, Consolas, monospace;
        font-size: 85%;
        line-height: 1.45;
      }}
      pre code {{ background-color: transparent; padding: 0; }}
      
      /* Pygments 語法高亮樣式 */
      {pygments_css}
      
      table {{
        border-collapse: collapse;
        width: 100%;
        margin: 1em 0;
      }}
      th, td {{
        border: 1px solid #dfe2e5;
        padding: 6px 13px;
      }}
      th {{ background-color: #f6f8fa; font-weight: 600; }}
      tr:nth-child(even) {{ background-color: #f8f9fa; }}
    </style>
    </head>
    <body>
    {html_body}
    </body>
    </html>
    """

    temp_html = "temp_render.html"
    with open(temp_html, "w", encoding="utf-8") as f:
        f.write(html_content)

    HTML(temp_html).write_pdf(pdf_file)
    print(f"💚 Convert {md_file} to PDF {pdf_file} successfully")


if __name__ == "__main__":
    if len(sys.argv) < 3:
        print("Usage: python md2pdf.py <input.md> <output.pdf>")
        sys.exit(1)
    convert_md_to_a4_pdf(sys.argv[1], sys.argv[2])
