#!/bin/bash

set -e

SCRIPTS_COMMON_DIR="$HOME/.local/bin/common"
SCRIPTS_WAYLAND_DIR="$HOME/.local/bin/wayland"
SCRIPTS_HYPRLAND_DIR="$HOME/.local/bin/hyprland"
SCRIPTS_SWAY_DIR="$HOME/.local/bin/sway"
LOG_PATH="$HOME/.local/bin/logs/wofi_quick_memu.log"
WOFI_CMD="wofi --show dmenu --width 800 --height 400"

OPTIONS=(
	"Audio Output"
	"Audio Input"
	"Power Profile"
	"Toggle Sleep"
	"Toggle VPN"
	"Reload Config"
	"Restart PipeWire"
	"Restart NetworkManager"
	"Restart Wifi wlan0"
)

logger() {
	mkdir -p "$(dirname "$LOG_PATH")"
	echo "$(date): $*" >>"$LOG_PATH"
}

for cmd in wpctl wofi; do
	command -v $cmd >/dev/null 2>&1 || {
		echo "Missing $cmd"
		logger "Missing dependency: $cmd"
		notify-send "Missing dependency: $cmd"
		exit 1
	}
done

format_power_options() {
	local current=$(powerprofilesctl get)
	local output=""
	local modes=("⚡️|performance" "⚖️|balanced" "🐢|power-saver")

	for item in "${modes[@]}"; do
		local icon="${item%|*}"
		local m="${item#*|}"
		local prefix="  "
		[[ "$m" == "$current" ]] && prefix="* "
		output+="$prefix $icon $m\n"
	done
	echo -ne "$output"
}

set_power_mode() {
	local target=$1
	local icon urgency msg
	logger "Setting power profile to: $target"

	case "$target" in
	"performance")
		icon="🚀"
		urgency="critical"
		msg="Maximum performance enabled."
		;;
	"balanced")
		icon="⚖️"
		urgency="normal"
		msg="Dynamic balance enabled."
		;;
	"power-saver")
		icon="🐢"
		urgency="low"
		msg="System throttled for silence."
		;;
	esac

	if err_msg=$(powerprofilesctl set "$target" 2>&1); then
		notify-send -a "Power Manager" -u "$urgency" "$icon Power Mode: ${target^^}" "$msg"
	else
		logger "Power Mode Error: $err_msg"
		notify-send -a "Power Manager" -u critical "❌ Switch Failed" "$err_msg"
	fi
}

get_vpn_connections() {
	nmcli -t -f NAME,TYPE con show 2>/dev/null |
		grep -E ':(vpn|openvpn|wireguard|pptp|l2tp|vpnc|fortisslvpn|ipsec)$' |
		cut -d: -f1
}

format_vpn_options() {
	local active_connections=$(nmcli -t -f NAME con show --active 2>/dev/null)
	mapfile -t vpn_list < <(get_vpn_connections)
	local output=""
	for vpn_name in "${vpn_list[@]}"; do
		local status_icon="🔴"
		echo "$active_connections" | grep -q "^$vpn_name$" && status_icon="🟢"
		output+="$status_icon\t$vpn_name\n"
	done
	echo -e "$output"
}

toggle_vpn() {
	local vpn_name="$1"
	logger "Toggling VPN: $vpn_name"

	# 檢查 VPN 連線是否處於活躍狀態 (Active)
	if nmcli con show --active | grep -q "^$vpn_name[[:space:]]"; then
		# 狀態為活躍 (Active)，執行斷開連線
		logger "VPN $vpn_name is active. Deactivating..."
		notify-send "VPN: Disconnecting" "Deactivating $vpn_name..."
		if nmcli con down "$vpn_name"; then
			notify-send "VPN: Disconnected 📴" "$vpn_name is now disconnected."
		else
			notify-send "VPN Error" "Failed to disconnect $vpn_name."
		fi
	else
		# 狀態為非活躍 (Inactive)，執行連接
		logger "VPN $vpn_name is inactive. Activating..."
		notify-send "VPN: Connecting..." "Activating $vpn_name..."
		if nmcli con up "$vpn_name" | grep -q "successfully activated"; then
			notify-send "VPN: Connected 🔒" "$vpn_name successfully connected."
		else
			notify-send "VPN Error ❌" "Failed to connect to $vpn_name. Check configuration/logs."
		fi
	fi
}

select_audio_device() {
	logger "Selected mode: $1"
	local section prompt devices selected_line selected

	if [[ "$1" == "Audio Output" ]]; then
		logger "Setting section to Sinks"
		section="Sinks"
		prompt="Select Audio Output Device"
	elif [[ "$1" == "Audio Input" ]]; then
		logger "Setting section to Sources"
		section="Sources"
		prompt="Select Audio Input Device"
	else
		notify-send "Unknown audio type: $1"
		exit 1
	fi

	# Parsing logic with clean inline match
	devices=$(awk -v section="$section" '
        $0 ~ "^[[:space:]]*├─ "section":" { in_section=1; next }
        in_section && $0 ~ "^[[:space:]]*│" && $0 ~ /\[vol:/ {
            line=$0; sub(/^[ \t]*│[ \t]*/,"",line)
            if (match(line, /^\* +([0-9]+)\.\s+(.+)$/, parts)) printf "★ %s | %s\n", parts[1], parts[2]
            else if (match(line, /^([0-9]+)\.\s+(.+)$/, parts)) printf "  %s | %s\n", parts[1], parts[2]
            next
        }
        in_section && $0 !~ "^[[:space:]]*│" { in_section=0 }
    ' < <(wpctl status))

	[ -z "$devices" ] && {
		notify-send "No devices found!"
		exit 1
	}

	selected_line=$(printf "%s\n" "$devices" | $WOFI_CMD --prompt "$prompt")

	[ -z "$selected_line" ] && exit 0

	selected=$(echo "$selected_line" | sed 's/^[★ ]*//' | cut -d'|' -f1 | awk '{print $1}')

	logger "User selected device ID: $selected"

	local assets="$HOME/.local/share/byte4work/assets/"
	local icon
	local mic="$assets/mic.png"
	local speaker="$assets/speaker.png"
	local headsets="$assets/headsets.png"

	if [[ "$section" == "Sinks" ]]; then
		icon="$speaker"
	else
		icon="$mic"
	fi

	if [[ "$section" == "Sinks" ]] && ([[ "$selected_line" == *"headset"* ]] || [[ "$selected_line" == *"Headset"* ]]); then
		icon="$headsets"
	fi

	wpctl set-default "$selected"
	notify-send -i "$icon" "Audio device switched" "$1 set to: $(echo "$selected_line" | cut -d'|' -f2- | xargs)"
}

main() {
	selection=$(printf "%s\n" "${OPTIONS[@]}" | $WOFI_CMD --prompt "Quick Menu…")
	[ -z "$selection" ] && exit 0

	case "$selection" in
	"Audio Output" | "Audio Input") select_audio_device "$selection" ;;
	"Power Profile")
		local p_options=$(format_power_options)
		local selected_line=$(echo -e "$p_options" | $WOFI_CMD --prompt "Select Profile…")
		[ -n "$selected_line" ] && set_power_mode "$(echo "$selected_line" | awk '{print $NF}')"
		;;
	"Reload Config")
		if [ "$XDG_CURRENT_DESKTOP" = "Hyprland" ]; then
			result=$(hyprctl $INSTANCE_FLAG reload 2>&1)
			if [[ "$result" == "ok" ]]; then
				notify-send "Hyprland" "Config reloaded successfully!" -t 2000
			else
				notify-send "Hyprland Error" "Reload failed: $result" -t 4000
			fi
		else
			if swaymsg reload; then
				notify-send "Sway" "Config reloaded successfully!" -t 2000
			else
				notify-send "Sway Error" "Reload failed" -t 4000
			fi
		fi
		;;
	"Restart PipeWire")
		"$SCRIPTS_COMMON_DIR/byte4work-restart-pipewire"
		notify-send "PipeWire Restarted"
		;;
	"Restart NetworkManager")
		"$SCRIPTS_COMMON_DIR/byte4work-restart-network-manager"
		notify-send "NetworkManager Restarted"
		;;
	"Restart Wifi wlan0")
		"$SCRIPTS_COMMON_DIR/byte4work-restart-wifi-wlan0"
		notify-send "Wifi wlan0 Restarted"
		;;
	"Toggle Sleep") "$SCRIPTS_HYPRLAND_DIR/byte4work-hypridle-toggle" ;;
	"Toggle VPN")
		local vpn_options=$(format_vpn_options)
		local selected_line=$(echo -e "$vpn_options" | $WOFI_CMD --prompt "Select VPN to toggle…")
		[ -n "$selected_line" ] && toggle_vpn "$(echo "$selected_line" | awk -F'\t' '{print $2}')"
		;;
	*) notify-send "Unknown Selection" "Option '$selection' not implemented." ;;
	esac
}

main
