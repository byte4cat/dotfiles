#!/bin/bash

STATE_FILE="$HOME/.local/state/waypaper/default.toml"

mkdir -p "$(dirname "$STATE_FILE")"

FOLDERS=(
	"$HOME/.local/share/wallpapers"
)

if [ -f "$STATE_FILE" ]; then
	PREV_WALLPAPER=$(grep 'wallpaper =' "$STATE_FILE" | head -n 1 | sed 's/.*= //;s/"//g')
else
	touch "$STATE_FILE"
	PREV_WALLPAPER=""
fi

waypaper --state-file "$STATE_FILE" --folder "${FOLDERS[@]}"

if [ ! -s "$STATE_FILE" ]; then
	notify-send "Theme" "State file empty, exiting."
	exit 0
fi

CURRENT_WALLPAPER=$(grep 'wallpaper =' "$STATE_FILE" | head -n 1 | sed 's/.*= //;s/"//g')

if [ "$PREV_WALLPAPER" == "$CURRENT_WALLPAPER" ]; then
	notify-send "Theme" "No wallpaper change detected."
	exit 0
fi

RAW_PATH=$(grep 'wallpaper =' "$STATE_FILE" | head -n 1 | sed 's/.*= //;s/"//g')
SELECTED_WALLPAPER="${RAW_PATH/#\~/$HOME}"

echo "RAW_PATH: $RAW_PATH"
echo "SELECTED_WALLPAPER: $SELECTED_WALLPAPER"

if [ -z "$SELECTED_WALLPAPER" ]; then
	notify-send "Theme" "can not read wallpaper location" -t 2000
	exit 1
fi

if [ ! -f "$SELECTED_WALLPAPER" ]; then
	notify-send "Theme" "Wallpaper file not found!" -t 2000
	exit 1
fi

matugen image "$SELECTED_WALLPAPER" --quiet --source-color-index 0

notify-send "Theme" "Sync successful!" -i "$SELECTED_WALLPAPER" -t 1500

echo "Colors updated for $SELECTED_WALLPAPER"
