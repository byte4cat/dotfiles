#!/bin/bash
# Quick system menu built on walker (dmenu mode).
#
# Layers:
#   1. UI       : menu / notify / log_msg / require  (only place that talks to walker)
#   2. Actions  : action_* functions, one per feature (use return, never exit)
#   3. Registry : ENTRIES ("Label|function"), shown in order and dispatched by main
#
# To add a feature: write an action_* function, then add one line to ENTRIES.

SCRIPTS_COMMON_DIR="$HOME/.local/bin/common"
SCRIPTS_WAYLAND_DIR="$HOME/.local/bin/wayland"
SCRIPTS_HYPRLAND_DIR="$HOME/.local/bin/hyprland"
LOG_PATH="$HOME/.local/bin/logs/walker_quick_memu.log"
ASSETS_DIR="$HOME/.local/share/byte4work/assets"

WALKER_ARGS=(--dmenu --width 644 --minheight 1 --maxheight 300)

# =========================================================
# 1. UI layer
# =========================================================

log_msg() {
	mkdir -p "$(dirname "$LOG_PATH")"
	echo "$(date): $*" >>"$LOG_PATH"
}

# menu <placeholder>: read options from stdin, print the selected line
menu() {
	walker "${WALKER_ARGS[@]}" -p "$1"
}

notify() {
	notify-send "$@"
}

# require <cmd>: return 1 (and tell the user) when a dependency is missing
require() {
	command -v "$1" >/dev/null 2>&1 && return 0
	log_msg "Missing dependency: $1"
	notify -u critical "Missing dependency" "$1"
	return 1
}

# =========================================================
# 2. Action layer
# =========================================================

# ---------- Audio ----------

select_audio_device() {
	log_msg "Selected mode: $1"
	local section prompt devices selected_line selected icon

	case "$1" in
	"Audio Output")
		section="Sinks"
		prompt="Select Audio Output Device"
		;;
	"Audio Input")
		section="Sources"
		prompt="Select Audio Input Device"
		;;
	*)
		notify "Unknown audio type: $1"
		return 1
		;;
	esac

	devices=$(awk -v section="$section" '
        $0 ~ "^[[:space:]]*├─ "section":" { in_section=1; next }
        in_section && $0 ~ "^[[:space:]]*│" && $0 ~ /\[vol:/ {
            line=$0; sub(/^[ \t]*│[ \t]*/,"",line)
            if (match(line, /^\* +([0-9]+)\.\s+(.+)$/, parts)) printf "★ %s | %s\n", parts[1], parts[2]
            else if (match(line, /^([0-9]+)\.\s+(.+)$/, parts)) printf "  %s | %s\n", parts[1], parts[2]
            next
        }
        in_section && $0 !~ "^[[:space:]]*│" { in_section=0 }
    ' < <(wpctl status))

	if [ -z "$devices" ]; then
		notify "No devices found!"
		return 1
	fi

	selected_line=$(printf "%s\n" "$devices" | menu "$prompt…")
	[ -z "$selected_line" ] && return 0

	selected=$(echo "$selected_line" | sed 's/^[★ ]*//' | cut -d'|' -f1 | awk '{print $1}')
	log_msg "User selected device ID: $selected"

	if [[ "$section" == "Sinks" ]]; then
		icon="$ASSETS_DIR/speaker.png"
		[[ "${selected_line,,}" == *"headset"* ]] && icon="$ASSETS_DIR/headsets.png"
	else
		icon="$ASSETS_DIR/mic.png"
	fi

	if ! wpctl set-default "$selected"; then
		notify -u critical "Audio" "Failed to switch to device $selected"
		return 1
	fi

	if [[ "$section" == "Sinks" ]]; then
		for id in $(pactl list short sink-inputs | awk '{print $1}'); do
			pactl move-sink-input "$id" @DEFAULT_SINK@ 2>/dev/null || true
		done
	else
		for id in $(pactl list short source-outputs | awk '{print $1}'); do
			pactl move-source-output "$id" @DEFAULT_SOURCE@ 2>/dev/null || true
		done
	fi

	notify -i "$icon" "Audio device switched" "$1 set to: $(echo "$selected_line" | cut -d'|' -f2- | xargs)"
}

action_audio_output() { select_audio_device "Audio Output"; }
action_audio_input() { select_audio_device "Audio Input"; }

# mic_is_muted: return 0 when the default source is muted
mic_is_muted() {
	wpctl get-volume @DEFAULT_SOURCE@ 2>/dev/null | grep -q MUTED
}

action_mic_mute() {
	if ! wpctl set-mute @DEFAULT_SOURCE@ toggle; then
		notify -u critical "Microphone" "Failed to toggle mute"
		return 1
	fi
	if mic_is_muted; then
		log_msg "Mic muted"
		notify -i "$ASSETS_DIR/mic.png" "🔇 Microphone muted"
	else
		log_msg "Mic unmuted"
		notify -i "$ASSETS_DIR/mic.png" "🎙️ Microphone unmuted"
	fi
}

# ---------- Bluetooth ----------

# bluetooth_state: print "on", "off", or "none" (no controller)
bluetooth_state() {
	local info
	info=$(bluetoothctl show 2>/dev/null)
	if echo "$info" | grep -q "Powered: yes"; then
		echo on
	elif echo "$info" | grep -q "Powered: no"; then
		echo off
	else
		echo none
	fi
}

action_bluetooth() {
	require bluetoothctl || return 1

	local state target
	state=$(bluetooth_state)
	case "$state" in
	on) target=off ;;
	off) target=on ;;
	*)
		notify -u critical "Bluetooth" "No Bluetooth controller found"
		return 1
		;;
	esac

	log_msg "Bluetooth power $target"
	if bluetoothctl power "$target" >/dev/null 2>&1; then
		notify "Bluetooth" "Powered ${target^^}"
	else
		notify -u critical "Bluetooth" "Failed to power $target (check rfkill)"
		return 1
	fi
}

# ---------- Screenshot ----------

SCREENSHOT_OPTIONS=(
	"Screen"
	"Window"
	"Region"
	"Screen → Edit"
	"Window → Edit"
	"Region → Edit"
)

action_screenshot() {
	local choice mode edit=""
	choice=$(printf "%s\n" "${SCREENSHOT_OPTIONS[@]}" | menu "Screenshot…")
	[ -z "$choice" ] && return 0

	case "$choice" in
	Screen*) mode=full ;;
	Window*) mode=window ;;
	Region*) mode=region ;;
	*) return 1 ;;
	esac
	[[ "$choice" == *Edit ]] && edit=edit

	log_msg "Screenshot: $mode $edit"
	# Let walker close and focus return to the previous window first.
	sleep 0.3
	"$SCRIPTS_WAYLAND_DIR/byte4work-wl-screenshot" "$mode" $edit
}

# ---------- Power ----------

format_power_options() {
	local current output="" item icon m prefix
	current=$(powerprofilesctl get)

	local modes=(
		"⚡️|performance"
		"⚖️|balanced"
		"🐢|power-saver"
	)

	for item in "${modes[@]}"; do
		icon="${item%|*}"
		m="${item#*|}"
		prefix="  "
		[[ "$m" == "$current" ]] && prefix="* "
		output+="$prefix $icon $m\n"
	done
	printf "%b" "$output"
}

set_power_mode() {
	local target=$1
	local icon urgency msg err_msg

	log_msg "Setting power profile to: $target"

	case "$target" in
	"performance")
		icon="🚀"
		urgency="critical"
		msg="Maximum performance enabled. Fans may spin up."
		;;
	"balanced")
		icon="⚖️"
		urgency="normal"
		msg="Dynamic balance between power and acoustics."
		;;
	"power-saver")
		icon="🐢"
		urgency="low"
		msg="System throttled for silence and cool operation."
		;;
	esac

	if err_msg=$(powerprofilesctl set "$target" 2>&1); then
		notify -a "Power Manager" -u "$urgency" "$icon  Power Mode: ${target^^}" "$msg"
	else
		log_msg "Power Mode Error: $err_msg"
		notify -a "Power Manager" -u critical "❌ Switch Failed" "$err_msg"
		return 1
	fi
}

action_power_profile() {
	require powerprofilesctl || return 1

	local selected_line selected_mode
	selected_line=$(format_power_options | menu "Select Profile…")
	[ -z "$selected_line" ] && return 0

	selected_mode=$(echo "$selected_line" | awk '{print $NF}')
	if [ -n "$selected_mode" ]; then
		set_power_mode "$selected_mode"
	else
		log_msg "Error: Could not parse mode from $selected_line"
		notify -u critical "Parse Error" "Selected: $selected_line"
		return 1
	fi
}

action_toggle_sleep() {
	"$SCRIPTS_HYPRLAND_DIR/byte4work-hypridle-toggle"
}

# ---------- VPN ----------

# get_vpn_connections: print every configured VPN connection name
get_vpn_connections() {
	nmcli -t -f NAME,TYPE con show 2>/dev/null |
		grep -E ':(vpn|openvpn|wireguard|pptp|l2tp|vpnc|fortisslvpn|ipsec)$' |
		cut -d: -f1
}

# format_vpn_options: "<status>\t<name>" per VPN, 🟢 active / 🔴 inactive
format_vpn_options() {
	local active_connections vpn_name status_icon
	active_connections=$(nmcli -t -f NAME con show --active 2>/dev/null)

	while IFS= read -r vpn_name; do
		[ -z "$vpn_name" ] && continue
		if grep -qxF "$vpn_name" <<<"$active_connections"; then
			status_icon="🟢"
		else
			status_icon="🔴"
		fi
		printf "%s\t%s\n" "$status_icon" "$vpn_name"
	done < <(get_vpn_connections)
}

toggle_vpn() {
	local vpn_name="$1"
	log_msg "Toggling VPN: $vpn_name"

	if nmcli -t -f NAME con show --active | grep -qxF "$vpn_name"; then
		log_msg "VPN $vpn_name is active. Deactivating..."
		notify "VPN: Disconnecting" "Deactivating $vpn_name..."
		if nmcli con down "$vpn_name"; then
			notify "VPN: Disconnected 📴" "$vpn_name is now disconnected."
		else
			notify "VPN Error" "Failed to disconnect $vpn_name."
			return 1
		fi
	else
		log_msg "VPN $vpn_name is inactive. Activating..."
		notify "VPN: Connecting..." "Activating $vpn_name..."
		if nmcli con up "$vpn_name" | grep -q "successfully activated"; then
			notify "VPN: Connected 🔒" "$vpn_name successfully connected."
		else
			notify "VPN Error ❌" "Failed to connect to $vpn_name. Check configuration/logs."
			return 1
		fi
	fi
}

action_vpn() {
	local options selected_line selected_vpn
	options=$(format_vpn_options)

	if [ -z "$options" ]; then
		log_msg "No VPN connections found."
		notify "VPN Error" "No configured VPN connections found."
		return 0
	fi

	selected_line=$(printf "%s\n" "$options" | menu "Select VPN to toggle…")
	if [ -z "$selected_line" ]; then
		log_msg "VPN submenu cancelled."
		return 0
	fi

	selected_vpn=$(echo "$selected_line" | awk -F'\t' '{print $2}')
	toggle_vpn "$selected_vpn"
}

# ---------- System ----------

action_reload_config() {
	local result
	if [ "${XDG_CURRENT_DESKTOP:-}" = "Hyprland" ]; then
		result=$(hyprctl reload 2>&1)
		if [[ "$result" == "ok" ]]; then
			notify "Hyprland" "Config reloaded successfully!" -t 2000
		else
			notify "Hyprland Error" "Reload failed: $result" -t 4000
			return 1
		fi
	else
		if swaymsg reload; then
			notify "Sway" "Config reloaded successfully!" -t 2000
		else
			notify "Sway Error" "Reload failed" -t 4000
			return 1
		fi
	fi
}

action_restart_pipewire() {
	"$SCRIPTS_COMMON_DIR/byte4work-restart-pipewire" && notify "PipeWire Restarted"
}

action_restart_network_manager() {
	notify "Restarting NetworkManager"
	"$SCRIPTS_COMMON_DIR/byte4work-restart-network-manager" && notify "NetworkManager Restarted"
}

action_restart_wifi() {
	"$SCRIPTS_COMMON_DIR/byte4work-restart-wifi-wlan0" && notify "Wifi wlan0 Restarted"
}

# =========================================================
# 3. Registry layer
# =========================================================

ENTRIES=(
	"Audio Output|action_audio_output"
	"Audio Input|action_audio_input"
	"Toggle Mic Mute|action_mic_mute"
	"Toggle Bluetooth|action_bluetooth"
	"Screenshot|action_screenshot"
	"Power Profile|action_power_profile"
	"Toggle Sleep|action_toggle_sleep"
	"Toggle VPN|action_vpn"
	"Reload Config|action_reload_config"
	"Restart PipeWire|action_restart_pipewire"
	"Restart NetworkManager|action_restart_network_manager"
	"Restart Wifi wlan0|action_restart_wifi"
)

main() {
	local cmd entry selection
	for cmd in walker wpctl notify-send; do
		command -v "$cmd" >/dev/null 2>&1 || {
			echo "Missing $cmd" >&2
			log_msg "Missing dependency: $cmd"
			exit 1
		}
	done

	log_msg "Script started"

	selection=$(for entry in "${ENTRIES[@]}"; do printf "%s\n" "${entry%%|*}"; done | menu "Select item…")
	[ -z "$selection" ] && exit 0
	log_msg "User selected: $selection"

	for entry in "${ENTRIES[@]}"; do
		if [[ "${entry%%|*}" == "$selection" ]]; then
			"${entry#*|}"
			exit $?
		fi
	done

	log_msg "Unknown option selected: $selection"
	notify "Unknown Selection" "The selected option '$selection' is not yet implemented."
}

# Allow `source`-ing this file for testing without opening the menu.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	main "$@"
fi
