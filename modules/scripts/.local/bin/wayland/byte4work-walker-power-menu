#!/usr/bin/env bash

OPTIONS=(
	"🟢 Logout"
	"☯ Shutdown"
	"🔄 Reboot"
	"💤 Sleep"
	"🛌🏻 Hibernate"
	"🔒 Lock"
	"↻ Reload Hyprland Config"
	"❌ Cancel"
)

INSTANCE_FLAG="-i 0"

selection=$(printf "%s\n" "${OPTIONS[@]}" | walker --dmenu --width 644 --minheight 1 --maxheight 300 -p "Select option…")

if [[ -z "$selection" ]]; then
	exit 0
fi

case "$selection" in
"🟢 Logout")
	if [ "$XDG_CURRENT_DESKTOP" = "Hyprland" ]; then
		hyprctl $INSTANCE_FLAG dispatch "hl.dsp.exit()"
	else
		swaymsg exit
	fi
	;;
"☯ Shutdown")
	systemctl poweroff --no-wall
	;;
"🔄 Reboot")
	systemctl reboot --no-wall
	;;
"🛌🏻 Hibernate")
	systemctl hibernate
	;;
"💤 Sleep")
	systemctl suspend
	;;
"🔒 Lock")
	if [ "$XDG_CURRENT_DESKTOP" = "Hyprland" ]; then
		hyprlock
	else
		# Sway 通常使用 swaylock 或 swaylock-effects
		swaylock -f -c 000000
	fi
	;;
"↻ Reload Hyprland Config")
	result=$(hyprctl $INSTANCE_FLAG reload 2>&1)
	if [[ "$result" == "ok" ]]; then
		notify-send "Hyprland" "Config reloaded successfully!" -t 2000
	else
		notify-send "Hyprland Error" "Reload failed: $result" -t 4000
	fi
	;;
"❌ Cancel")
	exit 0
	;;
*)
	exit 0
	;;
esac
