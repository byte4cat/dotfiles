#!/usr/bin/env bash

ROFI_CMD="rofi -dmenu -width 600 -height 350 -p "Power Menu…""

OPTIONS=(
	"🟢 Logout"
	"☯ Shutdown"
	"🔄 Reboot"
	"💤 Sleep"
	"🛌🏻 Hibernate"
	"🔒 Lock"
	"❌ Cancel"
)

selection=$(printf "%s\n" "${OPTIONS[@]}" | rofi -dmenu -p "Power Menu…")

if [[ -z "$selection" ]]; then
	exit 0
fi

case "$selection" in
"🟢 Logout")
	i3-msg exit
	;;
"☯ Shutdown")
	systemctl poweroff --no-wall
	;;
"🔄 Reboot")
	systemctl reboot --no-wall
	;;
"🛌🏻 Hibernate")
	systemctl hibernate
	;;
"💤 Sleep")
	systemctl suspend
	;;
"🔒 Lock")
	# i3lock or betterlockscreen
	i3lock -f -c 000000
	;;
"❌ Cancel" | *)
	exit 0
	;;
esac
