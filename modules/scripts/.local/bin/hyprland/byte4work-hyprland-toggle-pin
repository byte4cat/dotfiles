#!/bin/bash
# NOTE: it's not working in hyprland anymore after v0.55
if [ "$(hyprctl activewindow -j | jq '.pinned')" = "true" ]; then
	hyprctl dispatch pin
	hyprctl dispatch togglefloating
else
	if [ "$(hyprctl activewindow -j | jq '.floating')" = "false" ]; then
		hyprctl dispatch togglefloating
	fi
	hyprctl dispatch pin
fi
