# i3 Configuration File - Migrated from Hyprland Setup

####################
### 1. 變數設定 ###
####################
font pango:monospace 14

# 設置 Mod 鍵
set $mod Mod4
set $altMod Mod1

# 核心路徑與工具定義 (完美同步你的 Hyprland 配置)
set $terminal ghostty
# set $terminal alacritty
set $fileManager thunar
set $browser librewolf
set $menu rofi -show drun
set $fileManager GTK_THEME=adw-gtk3-dark thunar
set $terminalFileManager ghostty -e yazi ~/Downloads
set $babycam byte4work-babycam
set $quickmenu byte4work-rofi-quick-menu
set $powermenu byte4work-rofi-power-menu

############################
### 2. 環境變數/多螢幕與 X11 設置 ###
############################

# 設置 X11 下的 Xcursor 大小
exec --no-startup-id xsetroot -cursor_name left_ptr
exec --no-startup-id xrdb -merge <<< "Xcursor.size: 24"

# 設置 GTK/Qt 暗色主題偏好
exec --no-startup-id gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"
exec --no-startup-id gsettings set org.gnome.desktop.interface gtk-theme "adw-gtk3"

# 【關鍵修正】多螢幕佈局：HDMI-A-1 垂直旋轉置於 DP-1 左側
# 旋轉後 HDMI-A-1 解析度變為 1200x1920，起點為 0x0
# 因此右邊的主螢幕 DisplayPort-1 起點必須向右偏移 1200 像素，即 1200x0
exec --no-startup-id xrandr --output HDMI-A-0 --mode 1920x1200 --pos 0x0 --rotate left --output DisplayPort-0 --mode 2560x1440 --pos 1200x0 --primary

# 視窗間距 (Gaps) 設置
set $gaps_in 5
set $gaps_out 10
gaps inner $gaps_in
gaps outer $gaps_out

###################
### 3. AUTOSTART ###
###################

# 壁紙與合成器
exec_always --no-startup-id feh --bg-fill ~/.local/share/wallpapers/171652.jpg
exec_always --no-startup-id picom --config ~/.config/picom/picom.conf -b

# 系統元件
exec --no-startup-id dunst
exec --no-startup-id polybar
exec --no-startup-id fcitx5
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# 鍵盤映射 (Capslock 轉 Ctrl)
exec --no-startup-id sleep 3 && setxkbmap -option ctrl:nocaps

# 剪貼簿歷史管理 (X11 專用環境)
exec --no-startup-id clipmenud &



#########################
### 4. 視窗外觀與規則 ###
#########################

# 預設 1 像素邊框
default_border pixel 1
for_window [class="^.*"] border pixel 1

# 浮動視窗規則
for_window [class="Rofi"] floating enable
for_window [class="Rofi"] focus_on_window activation
for_window [class="Rofi"] move position center

###################
### 5. 按鍵綁定 ###
###################

# === 基礎核心操作 ===
bindsym $mod+Return exec $terminal
bindsym $mod+q kill
bindsym $mod+m exec $powermenu
bindsym $mod+b exec $browser
bindsym $mod+Shift+e exec $fileManager
bindsym $mod+e exec $terminalFileManager
bindsym $mod+d exec $menu

# === 視窗狀態操作 ===
bindsym $mod+Shift+f floating toggle
bindsym $mod+f fullscreen toggle
bindsym $mod+p layout toggle split       # 模擬 pseudo 效果
bindsym $mod+n focus next                # 切換下一個視窗
bindsym $mod+c exec $quickmenu
bindsym $mod+w exec byte4work-waypaper-selector
bindsym $mod+Shift+b exec $babycam

# === 剪貼簿歷史 ===
bindsym $mod+$altMod+c exec clipmenu

# === 移動焦點 (Vim Style) ===
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# === 移動視窗位置 ===
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# === 【直覺式智慧縮放】(免進入 Resize 模式) ===
bindsym $mod+Ctrl+Shift+h resize shrink width 30 px or 2 ppt
bindsym $mod+Ctrl+Shift+j resize grow height 30 px or 2 ppt
bindsym $mod+Ctrl+Shift+k resize shrink height 30 px or 2 ppt
bindsym $mod+Ctrl+Shift+l resize grow width 30 px or 2 ppt

# === 【關鍵設定】工作區與螢幕絕對綁定 (1~9 歸主螢幕，10 歸副螢幕) ===
workspace 1 output DisplayPort-0
workspace 2 output DisplayPort-0
workspace 3 output DisplayPort-0
workspace 4 output DisplayPort-0
workspace 5 output DisplayPort-0
workspace 6 output DisplayPort-0
workspace 7 output DisplayPort-0
workspace 8 output DisplayPort-0
workspace 9 output DisplayPort-0
workspace 10 output HDMI-A-0

# === 工作區快速切換 (1-10) ===
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# === 移動視窗到指定工作區 ===
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# 回到上一次使用的工作區 (同 $mod+TAB)
bindsym $mod+Tab workspace back_and_forth

# === 滑鼠拖曳與縮放綁定 ===
floating_modifier $mod
tiling_drag modifier titlebar

# === 截圖系統 (因應 X11 精準調整) ===
# 呼叫你原本存在 ~/.local/bin/x11/ 下的 x11 專用腳本
bindsym $mod+Control+1 exec ~/.local/bin/x11/byte4work-screenshot window  # 全螢幕/視窗
bindsym $mod+Control+2 exec ~/.local/bin/x11/byte4work-screenshot window
bindsym $mod+Control+3 exec ~/.local/bin/x11/byte4work-screenshot region
bindsym $mod+Control+Shift+1 exec ~/.local/bin/x11/byte4work-screenshot save-full
bindsym $mod+Control+Shift+2 exec ~/.local/bin/x11/byte4work-screenshot save-window
bindsym $mod+Control+Shift+3 exec ~/.local/bin/x11/byte4work-screenshot save-region

# === 多媒體控制與音量 ===
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym $mod+bracketright exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym $mod+bracketleft exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym $mod+backslash exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# 亮度控制
bindsym XF86MonBrightnessUp exec brightnessctl -e4 -n2 set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl -e4 -n2 set 5%-

# 多媒體播放播放控制
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPause exec playerctl play-pause

# === 退出 i3 會話 ===
bindsym $mod+Shift+m exec i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'

############################
### 6. 傳統 RESIZE 模式 (保留) ###
############################
mode "resize" {
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"
