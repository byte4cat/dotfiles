# Ghostty Config

# theme = "Ultra Dark"
theme = "Matugen"
background-opacity = 1.0

font-family = "monospace"
# we set font order by .config/fontconfig/fonts.conf
# Comic Code
# JetBrainsMono Nerd Font Mono
# LXGW WenKai Mono 霞鶩文楷
# Noto Sans Mono CJK TC
# Noto Mono Mono CJK JP
# Noto Mono Mono CJK KR
# Noto Color Emoji😀

font-feature = "calt"
font-feature = "liga"

font-size = 12

adjust-cell-height = 15%

shell-integration-features = no-cursor,no-sudo,no-title

gtk-titlebar = false

confirm-close-surface = false

clipboard-read = allow
clipboard-write = allow

# page scrolling
keybind = "ctrl+shift+f=scroll_page_fractional:0.5"
keybind = "ctrl+shift+b=scroll_page_fractional:-0.5"

# remove toggle fullscreen
keybind = "ctrl+enter=unbind"
keybind = "shift+enter=unbind"
