{
	"output": "__PRIMARY_MONITOR__",
	"reload_style_on_change": true,
	"layer": "top",
	"position": "top",
	"spacing": 0,
	"height": 26,
	"modules-left": ["group/left1", "group/left-tomat", "group/left2"],
	"group/left1": { "orientation": "inherit", "modules": 
		[
		  // "custom/menu",
		  "hyprland/workspaces"
		]
	},

	"group/left-tomat": {
        "orientation": "inherit",
        "modules": [ "custom/tomat" ]
    },

	"group/left2": { "orientation": "inherit", "modules": ["hyprland/window"] },
	"modules-center": [
		"clock"
	],
	"modules-right": ["group/right1", "group/right2", "group/right3"],
	"group/right3": {
		"orientation": "inherit",
		"modules": [ "pulseaudio", "backlight", "network", "bluetooth", "battery"]
	},
	"group/right2": { "orientation": "inherit", "modules": ["tray", "cpu", "memory"] },
	"group/right1": { "orientation": "inherit", "modules": ["mpris"] },

	"hyprland/workspaces": {
		"disable-scroll": true,
		"all-outputs": true,
		"format": "{icon}",
		"persistent-workspaces": { "*": 5 }
	},
	"custom/menu": {
		"format": "",
		"on-click": "wofi --show drun",
		"on-click-right": "ghostty"
	},
	"custom/tomat": {
		"exec": "~/.cargo/bin/tomat status",
		"interval": 1,
		"return-type": "json",
		"format": "{}",
		"on-click": "~/.cargo/bin/tomat toggle",       // 左鍵：暫停 / 繼續
		"on-click-right": "~/.cargo/bin/tomat skip",   // 右鍵：跳過目前階段（直接進入休息或工作）
		"on-click-middle": "~/.cargo/bin/tomat stop"   // 中鍵：完全停止番茄鐘
	},
	"cpu": {
		"interval": 5,
		"format": "󰍛 {usage}%",
		"on-click": "ghostty -e btop"
	},
	"clock": {
		"format": "{:%H:%M | %m/%d %a}",
		"tooltip": true,
		"tooltip-format": "<tt><small>{calendar}</small></tt>",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"weeks-pos": "right",
			"on-scroll": 1,
			"format": {
				"months": "<span color='#ffead3'><b>{}</b></span>",
				"days": "<span color='#ecc6d9'><b>{}</b></span>",
				"weeks": "<span color='#99ffdd'><b>W{}</b></span>",
				"weekdays": "<span color='#ffcc66'><b>{}</b></span>",
				"today": "<span color='#ff6666'><b><u>{}</u></b></span>"
			}
		}
	},
	"network": {
		"format-wifi": "󰤨 {essid}",
		"format-ethernet": "󰀂",
		"format-disconnected": "󰤮",
		"on-click": "nm-connection-editor"
	},
	"battery": {
		"format": "{capacity}% {icon}",
		"format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
		"states": { "warning": 20, "critical": 10 }
	},
	"bluetooth": {
		"format": "",
		"format-disabled": "󰂲",
		"on-click": "blueman-manager"
	},
	"pulseaudio": {
		"format": "{icon} {volume}%",
		"on-click": "pavucontrol",
		"on-click-right": "pamixer -t",
		"format-muted": "",
		"format-icons": { "default": ["", "", ""] }
	},
	"tray": {
		"icon-size": 14,
		"spacing": 6
	},
	"backlight": {
		"format": "{percent}% {icon}",
		"format-icons": ["🌑", "🌘", "🌗", "🌖", "🌕"]
	},
	"memory": {
		"format": " {used:0.1f}gb",
		"interval": 2
	},
	"mpris": {
		"format": "{artist} - {title}"
	},
	"hyprland/window": {
		"format": "{}",
		"max-length": 45
	}
}
