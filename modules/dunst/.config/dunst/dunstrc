# See dunst(5) for all configuration options

[global]
    ### Display ###
    monitor = 0
    follow = none

    ### Geometry ###
    width = 300
    height = (0, 300)
    origin = top-right
    offset = (10, 50)
    scale = 0
    notification_limit = 20

    # 🌟 關鍵調整 1: 設置最大透明度 (越接近 100 越透明)
    # Dunst 的透明度是 (100 - X) / 100。
    # 設定 90 意味著 90% 透明度，只保留 10% 不透明度。
    transparency = 50

    separator_height = 2
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 8

    # 框架寬度和顏色
    frame_width = 1
    frame_color = "#3B4252"  # 使用較深的 Nord 灰色作為邊框

    gap_size = 0
    separator_color = frame
    sort = yes

    ### Text and Fonts ###
    font = "JetBrains Mono 10"
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    stack_duplicates = true
    show_indicators = yes

    ### Icons ###
    enable_recursive_icon_lookup = true
    icon_theme = Papirus
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    ### Corner Radius (匹配您的 SwayNC 圓角) ###
    corner_radius = 22 # 匹配您的 --border-radius: 22px
    corners = all

    ### ... (其他設定保持原樣) ...
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

# 🌟 關鍵調整 2: 設置背景顏色，模仿您的 SwayNC 顏色
# 使用深灰色調，與高透明度結合達到毛玻璃效果。
[urgency_low]
    background = "#2E3440"  # Nord Darker
    foreground = "#D8DEE9"  # Nord Light Text
    timeout = 5
    default_icon = dialog-information

[urgency_normal]
    background = "#2E3440"  # Nord Darker
    foreground = "#ECEFF4"  # Nord Brighter Text
    timeout = 5
    default_icon = dialog-information

[urgency_critical]
    # 保持批判性通知顏色不變，確保可見性
    background = "#BF616A"  # Nord Red
    foreground = "#ECEFF4"
    frame_color = "#BF616A"
    timeout = 0
    default_icon = dialog-warning

# vim: ft=cfg
